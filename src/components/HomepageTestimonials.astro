---
/**
 * HomepageTestimonials — passo 4 (home reautorada no vocabulário "mar e sol").
 * Conteúdo real via homeContent (intacto). Estrelas/etiquetas em azul estrutural (sem âmbar).
 */
import { homeContent } from "../data/homeContent.js";

const { lang } = Astro.props;
const section = homeContent[lang].testimonialsSection;
---

<section class="testimonials">
  <div class="container">
    <header class="testimonials-head">
      <h2 class="testimonials-headline">{section.title}</h2>
      <p class="testimonials-intro measure">{section.subtitle}</p>
    </header>

    <div class="testimonials-grid">
      {section.quotes.map((quote) => (
        <figure class="quote">
          <div class="quote__top">
            <span class="quote__stars" aria-label={`${quote.rating}/5`}>
              {"★".repeat(quote.rating)}<span class="quote__stars-empty">{"★".repeat(5 - quote.rating)}</span>
            </span>
            <span class="quote__source">{quote.source}</span>
          </div>

          <blockquote class="quote__text">{quote.text}</blockquote>

          <figcaption class="quote__caption">
            <span class="quote__author">{quote.author}</span>
            <span class="quote__meta">{quote.context} · {quote.tour}</span>
            {section.originalLanguageNote && (
              <span class="quote__lang-note">{section.originalLanguageNote}</span>
            )}
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="testimonials-aggregate">{section.aggregateLine}</p>
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-3xl);
    background-color: var(--color-surface);
  }

  .testimonials-head {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-2xl);
  }

  .testimonials-headline {
    font-family: var(--font-display);
    font-size: var(--text-4);
    line-height: var(--line-tight);
    color: var(--color-blue);
    margin: 0;
  }

  .testimonials-intro {
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: var(--color-text-muted);
    margin: var(--space-s) 0 0;
  }

  .testimonials-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
    padding: var(--space-l);
    background: var(--color-base);
    border: var(--border-width-hairline) solid var(--color-hairline);
    border-radius: var(--radius-md);
  }

  .quote__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  /* Estrelas em azul estrutural — não âmbar (âmbar é só reserva). */
  .quote__stars {
    font-size: var(--text-0);
    letter-spacing: 0.08em;
    color: var(--color-blue);
  }
  .quote__stars-empty {
    color: color-mix(in srgb, var(--color-blue) 25%, transparent);
  }

  .quote__source {
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .quote__text {
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: var(--color-text);
    margin: 0;
  }
  .quote__text::before { content: "“"; }
  .quote__text::after { content: "”"; }

  .quote__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-start: auto;
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width-hairline) solid var(--color-hairline);
  }

  .quote__author {
    font-size: var(--text-0);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .quote__meta,
  .quote__lang-note {
    font-size: var(--text--1);
    color: var(--color-text-muted);
  }
  .quote__lang-note {
    font-style: italic;
  }

  .testimonials-aggregate {
    margin: var(--space-2xl) 0 0;
    font-size: var(--text--1);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .testimonials-headline {
      font-size: var(--text-3);
    }
  }
</style>
