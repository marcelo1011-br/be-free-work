---
/**
 * HomepageTestimonials — B2. Reviews reais reautoradas sobre bone.
 * SectionHeader assimétrico + layout 1 grande / 2 pequenos. reviews/quotes
 * permanecem visíveis (o schema os exige). Estrelas/etiquetas em azul
 * estrutural. Âmbar: NÃO.
 */
import { homeContent } from "../data/homeContent.js";
import SectionHeader from "./SectionHeader.astro";

const { lang } = Astro.props;
const section = (homeContent[lang] ?? homeContent.en).testimonialsSection;

const [feature, ...rest] = section.quotes;
---

<section class="testimonials">
  <div class="container">
    <SectionHeader title={section.title} intro={section.subtitle} />

    <div class="t-grid">
      {[feature, ...rest].map((quote, i) => (
        <figure class={`quote ${i === 0 ? "quote--feature" : ""}`}>
          <div class="quote__top">
            <span class="quote__stars" aria-label={`${quote.rating}/5`}>
              {"★".repeat(quote.rating)}<span class="quote__stars-empty">{"★".repeat(5 - quote.rating)}</span>
            </span>
            <span class="quote__source">{quote.source}</span>
          </div>

          <blockquote class="quote__text">{quote.text}</blockquote>

          <figcaption class="quote__caption">
            <span class="quote__author">{quote.author}</span>
            <span class="quote__meta">{quote.context} · {quote.tour}</span>
            {section.originalLanguageNote && (
              <span class="quote__lang-note">{section.originalLanguageNote}</span>
            )}
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="testimonials-aggregate">{section.aggregateLine}</p>
  </div>
</section>

<style>
  /* `background` (shorthand) zera o gradiente legado de .testimonials (@layer
     themes, global.css). Scoped unlayered vence o layered → bone limpo. */
  .testimonials {
    padding-block: var(--space-3xl);
    background: var(--color-base);
  }

  /* 1 grande / 2 pequenos: feature ocupa a linha cheia; os outros dois dividem. */
  .t-grid {
    margin-block-start: var(--space-2xl);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
    padding: var(--space-l);
    background: var(--color-surface);
    border: var(--border-width-hairline) solid var(--color-hairline);
    border-radius: var(--radius-md);
  }

  .quote__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  /* Estrelas em azul estrutural — não âmbar (âmbar é só reserva). */
  .quote__stars {
    font-size: var(--text-0);
    letter-spacing: 0.08em;
    color: var(--color-blue);
  }
  .quote__stars-empty {
    color: color-mix(in srgb, var(--color-blue) 25%, transparent);
  }

  .quote__source {
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .quote__text {
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: var(--color-text);
    margin: 0;
  }
  .quote__text::before { content: "“"; }
  .quote__text::after { content: "”"; }

  .quote__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-start: auto;
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width-hairline) solid var(--color-hairline);
  }

  .quote__author {
    font-size: var(--text-0);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .quote__meta,
  .quote__lang-note {
    font-size: var(--text--1);
    color: var(--color-text-muted);
  }
  .quote__lang-note {
    font-style: italic;
  }

  .testimonials-aggregate {
    margin: var(--space-2xl) 0 0;
    font-size: var(--text--1);
    color: var(--color-text-muted);
  }

  /* Feature: citação maior, mais ar. */
  .quote--feature .quote__text {
    font-size: var(--text-2);
  }

  /* ≥48rem: duas colunas; a feature atravessa as duas. */
  @media (min-width: 48rem) {
    .t-grid {
      grid-template-columns: 1fr 1fr;
    }
    .quote--feature {
      grid-column: 1 / -1;
    }
  }
</style>
