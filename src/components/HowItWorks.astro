---
import { homeContent } from "../data/homeContent.js";

const { lang } = Astro.props;
const content = (homeContent[lang] ?? homeContent.en).howItWorks;

const editorialIntro = {
  en: {
    kicker: "Private, flexible, local",
    text: "Start with a proven Rio route or tell us what you care about. Our team turns that into a private day with the right guide, timing, transport and pace."
  },
  es: {
    kicker: "Privado, flexible y local",
    text: "Comienza con una ruta probada en Río o cuéntanos qué te interesa. Nuestro equipo lo convierte en un día privado con el guía, los tiempos, el transporte y el ritmo adecuados."
  },
  "pt-br": {
    kicker: "Privativo, flexível e local",
    text: "Comece com um roteiro já testado no Rio ou conte o que você quer viver. Nossa equipe transforma isso em um dia privativo com guia, horários, transporte e ritmo certos."
  }
};

const intro = editorialIntro[lang] ?? editorialIntro.en;
---

<section class="how-it-works section-spacious">
  <div class="container-editorial">
    <div class="process-layout">
      <div class="process-copy">
        <p class="editorial-kicker">{intro.kicker}</p>
        <h2 class="section-title">{content.title}</h2>
        <p class="process-intro measure">{intro.text}</p>
        <div class="section-cta">
          <button type="button" class="btn btn-primary btn-lg" data-tour-select-trigger>
            {lang === "pt-br" ? "Reservar Meu Passeio" : lang === "es" ? "Reservar Mi Tour" : "Book My Tour"}
          </button>
        </div>
      </div>

      <ol class="process-steps" aria-label={content.title}>
        {content.steps.map((step, index) => (
          <li class="process-step">
            <div class="process-step__number">{index + 1}</div>
            <div class="process-step__content">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__description">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    --process-step-number-size: clamp(2.75rem, 5vw, 3.25rem);
    --process-divider: color-mix(in srgb, var(--color-text-light) 14%, transparent);

    background-color: var(--color-bg-white);
  }

  .process-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .process-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: sticky;
    top: calc(var(--space-3xl) + var(--space-lg));
  }

  .section-title {
    color: var(--color-text);
    margin: 0;
  }

  .process-intro {
    color: var(--color-text-light);
    font-size: var(--font-size-h5);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: process;
  }

  .process-step {
    display: grid;
    grid-template-columns: var(--process-step-number-size) minmax(0, 1fr);
    gap: var(--space-lg);
    padding: var(--space-xl) 0;
    border-top: var(--border-width-hairline) solid var(--process-divider);
  }

  .process-step:last-child {
    border-bottom: var(--border-width-hairline) solid var(--process-divider);
  }

  .process-step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--process-step-number-size);
    height: var(--process-step-number-size);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: 50%;
    color: var(--color-accent);
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
  }

  .process-step__title {
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .process-step__description {
    font-size: var(--font-size-body);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .section-cta {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--space-xl);
  }

  .section-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .section-cta .btn-primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  @media (max-width: 900px) {
    .process-layout {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .process-copy {
      position: static;
    }

    .section-cta {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .how-it-works {
      padding-block: var(--section-space-md);
    }

    .process-layout {
      gap: var(--space-lg);
    }

    .process-intro {
      font-size: var(--font-size-body);
    }

    .process-step {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding: var(--space-lg) 0;
    }

    .process-step__title {
      font-size: var(--font-size-body);
    }

    .process-step__description {
      font-size: var(--font-size-small);
    }
  }
</style>
