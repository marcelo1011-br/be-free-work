---
/**
 * HowItWorks — passo 4 (home reautorada no vocabulário "mar e sol").
 * Conteúdo real via homeContent (intacto). Header editorial à esquerda + passos numerados.
 * Âmbar: NÃO. O CTA aqui é solid-navy (azul estrutural chapado, peso sem âmbar) —
 * o âmbar de reserva da home é nav + hero + cunha (teto 3); este fica fora dele.
 */
import { homeContent } from "../data/homeContent.js";
import Button from "./Button.astro";
import SectionHeader from "./SectionHeader.astro";

const { lang } = Astro.props;
const content = (homeContent[lang] ?? homeContent.en).howItWorks;

const ctaLabel =
  lang === "pt-br" ? "Reservar Meu Passeio" : lang === "es" ? "Reservar Mi Tour" : "Book My Tour";
---

<section class="how-it-works">
  <div class="container">
    <SectionHeader title={content.title} />

    <ol class="how-steps">
      {content.steps.map((step, index) => (
        <li class="how-step">
          <span class="how-step__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="how-step__title">{step.title}</h3>
          <p class="how-step__desc measure">{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="how-cta">
      <Button variant="solid-navy" size="lg" data-tour-select-trigger>{ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  /* Superfície BRANCA (token --color-surface, não cor crua) — quebra a emenda com
     o Why Choose (bone) adjacente: Featured Tours (bone) → How It Works (branco) →
     Why Choose (bone) → cunha (azul). `background` (shorthand) zera o gradiente
     legado de .how-it-works (@layer themes); scoped unlayered vence o layered. */
  .how-it-works {
    padding-block: var(--space-3xl);
    background: var(--color-surface);
  }

  .how-head {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-2xl);
  }

  .how-headline {
    font-family: var(--font-display);
    font-size: var(--text-4);
    line-height: var(--line-tight);
    color: var(--color-blue);
    margin: 0;
  }

  /* Passos: grid assimétrico — números serifados grandes, alinhados à esquerda. */
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .how-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width-strong) solid var(--color-blue);
  }

  .how-step__num {
    font-family: var(--font-display);
    font-size: var(--text-3);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: color-mix(in srgb, var(--color-blue) 40%, transparent);
  }

  .how-step__title {
    font-size: var(--text-1);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-snug);
    color: var(--color-text);
    margin: var(--space-2xs) 0 0;
  }

  .how-step__desc {
    font-size: var(--text-0);
    line-height: var(--line-normal);
    color: var(--color-text-muted);
    margin: 0;
  }

  .how-cta {
    display: flex;
    margin-block-start: var(--space-2xl);
  }

  @media (max-width: 600px) {
    .how-headline {
      font-size: var(--text-3);
    }
    .how-cta :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
