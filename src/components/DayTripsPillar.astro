---
/**
 * DayTripsPillar.astro — pillar "day trips / bate e volta" (mar-e-sol).
 *
 * Consome dayTripsContent.js (prose por locale + fatos + contato). Recebe `lang`.
 * Hero é INLINE aqui (HeroPages é rígido: só title/subtitle, sem CTAs).
 *
 * RESOLUÇÃO DE HREF (nada hardcodado):
 *  - Cards de destino: tourKey -> slug localizado via tours.js. tours.en[i].slug
 *    é a chave EN canônica; o índice i é consistente entre locales (mesmo `order`
 *    em build()). Logo tours[lang][idx].slug = slug localizado do mesmo tour.
 *  - 'quote' (hero primário + finalCta): routes[lang].contact (single-source).
 *  - 'destinations' (hero secundário): âncora #destinations nesta página.
 *
 * DISCIPLINA ÂMBAR: 1 único âmbar no corpo = hero primaryCta (variant="book").
 * finalCta = solid-navy (peso sem âmbar, padrão HomeFinalCTA). Cards = outline.
 * Hero secundário = ghost bone escopado. FAQ reusa FAQ.astro (footer outline).
 *
 * Superfícies: hero navy sólido (--color-blue / --color-on-blue, par AA estável);
 * demais seções bone (--color-base); cards elevados em --color-surface. Sem
 * laranja fora do único âmbar. global.css intocado — tudo scoped aqui.
 */
import { tours } from "../data/tours.js";
import { routes } from "../i18n/routes.js";
import {
  dayTripsProse,
  dayTripsDestinations,
} from "../data/dayTripsContent.js";
import Button from "./Button.astro";
import FAQ from "./FAQ.astro";
import { Image } from "astro:assets";
// Trust bar: dado (siteData — fonte única, a MESMA do AggregateRating) + rótulos (ui.js).
// Conteúdo VISÍVEL; não gera schema. aggregateRating INTACTO. foundedYear existe em
// siteData (fato de negócio) mas não é consumido aqui — trust.since já traz o ano no texto.
import { aggregateRating, travelersServed } from "../data/siteData.js";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = dayTripsProse[lang];
const tr = useTranslations(lang);

// Nº de viajantes formatado por locale: 15,000 (EN/ES) · 15.000 (PT-BR).
const travelersFmt = travelersServed.toLocaleString(lang === "pt-br" ? "pt-BR" : "en-US");

// Segmento de rota do tour por locale (mesmo mapa que TourCard/hreflang usam inline).
const tourRoutes = { en: "private-tours", es: "tours-privados", "pt-br": "passeios-privados" };

// tours.en[i].slug === chave EN; índice consistente entre locales (build() usa o mesmo order).
const enSlugs = tours.en.map((tt) => tt.slug);
function tourHref(tourKey) {
  const idx = enSlugs.indexOf(tourKey);
  if (idx === -1) return null;
  return `/${lang}/${tourRoutes[lang]}/${tours[lang][idx].slug}/`;
}

// Token 'quote' -> página de contato localizada (routes.js já traz "/contact/" etc.).
const quoteHref = `/${lang}${routes[lang].contact}`;

// Imagens de destino (hero webp por tourKey) — glob estático, resolvido no build.
const heroImages = import.meta.glob("../images/tours/heroes/*-hero.webp", { eager: true });
function destImage(tourKey) {
  return heroImages[`../images/tours/heroes/${tourKey}-hero.webp`]?.default;
}

// Eyebrow "for X" (reusa moodMenu, keyed por destKey) e meta (duração · preço, de
// tours.js). fromLabel = mapa local por locale (mesmo padrão do homeLabel abaixo);
// NENHUM arquivo de dado é tocado — só leitura de tours.js/dayTripsContent já importados.
const moodLabel = Object.fromEntries(t.moodMenu.items.map((m) => [m.destKey, m.label]));
const fromLabel = { en: "From", es: "Desde", "pt-br": "A partir de" }[lang];
function destMeta(tourKey) {
  const idx = enSlugs.indexOf(tourKey);
  const tt = tours[lang]?.[idx];
  if (!tt) return null;
  const p = tt.pricing || {};
  if (p.custom) return tt.duration; // a duração já carrega "sob consulta"
  const from = p.from ?? (p.standard ? Math.min(...Object.values(p.standard)) : null);
  return from != null ? `${tt.duration} · ${fromLabel} US$ ${from}` : tt.duration;
}

// Blocos de destino: fatos + href localizado + prose + eyebrow + meta.
const destBlocks = dayTripsDestinations.map((d) => ({
  ...d,
  href: tourHref(d.tourKey),
  image: destImage(d.tourKey),
  prose: t.destinations[d.key],
  eyebrow: moodLabel[d.key],
  meta: destMeta(d.tourKey),
}));

// FAQ.astro espera {question, answer}; a prose usa {q, a}.
const faqQuestions = t.faqs.map((f) => ({ question: f.q, answer: f.a }));

const homeLabel = { en: "Home", es: "Inicio", "pt-br": "Início" }[lang];
---

<!-- HERO (navy sólido, inline) -->
<section class="dt-hero">
  <div class="container dt-hero__inner">
    <h1 class="dt-hero__title">{t.hero.title}</h1>
    <p class="dt-hero__subtitle">{t.hero.subtitle}</p>
    <div class="dt-hero__actions">
      <Button variant="book" size="lg" href={quoteHref}>{t.hero.primaryCta.label}</Button>
      <a class="dt-hero__ghost" href="#destinations">{t.hero.secondaryCta.label}</a>
    </div>
  </div>
</section>

<!-- TRUST BAR (branco + hairline; CONTEÚDO VISÍVEL, não schema). Cada item = dado
     (siteData: rating/travelersServed) + rótulo localizado (ui.js trust.*). O
     AggregateRating já vive no LocalBusiness via siteData — aqui só exibimos. -->
<section class="dt-trust">
  <div class="container dt-trust__inner">
    <span class="dt-trust__item dt-trust__item--rating">
      <span aria-hidden="true">★</span> {aggregateRating.ratingValue}
      <span class="dt-trust__sub">· {aggregateRating.reviewCount}+ {tr("trust.reviews")}</span>
    </span>
    <span class="dt-trust__div" aria-hidden="true"></span>
    <span class="dt-trust__item">{tr("trust.licensed")}</span>
    <span class="dt-trust__div" aria-hidden="true"></span>
    <span class="dt-trust__item">{tr("trust.since")}</span>
    <span class="dt-trust__div" aria-hidden="true"></span>
    <span class="dt-trust__item">{tr("trust.private")}</span>
    <span class="dt-trust__div" aria-hidden="true"></span>
    <span class="dt-trust__item">~{travelersFmt} {tr("trust.travellers")}</span>
  </div>
</section>

<!-- INTRO (bone, coluna estreita ~65ch) -->
<section class="dt-intro">
  <div class="container">
    <div class="dt-intro__inner measure">
      <p class="dt-kicker">{t.intro.kicker}</p>
      <div class="dt-intro__copy">
        {t.intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<!-- MOOD MENU (bone, 3 cards -> âncora do destino) -->
<section class="dt-mood">
  <div class="container">
    <h2 class="dt-h2">{t.moodMenu.title}</h2>
    <ul class="dt-mood__grid">
      {t.moodMenu.items.map((m) => (
        <li>
          <a class="dt-mood__card" href={`#dest-${m.destKey}`}>
            <span class="dt-mood__label">{m.label}</span>
            <span class="dt-mood__text">{m.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- DESTINATIONS (linhas full-bleed alternadas: imagem sangra num lado, texto no outro) -->
<section class="dt-destinations" id="destinations">
  {destBlocks.map((d, i) => (
    <article class="dt-dest" id={`dest-${d.key}`}>
      <div class="dt-dest__media">
        <span class="dt-dest__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        {d.image && (
          <Image
            src={d.image}
            alt={d.prose.name}
            width={760}
            height={560}
            class="dt-dest__img"
            loading={i === 0 ? "eager" : "lazy"}
          />
        )}
      </div>
      <div class="dt-dest__body">
        <div class="dt-dest__inner">
          {d.eyebrow && <p class="dt-dest__eyebrow">{d.eyebrow}</p>}
          <h2 class="dt-dest__name">{d.prose.name}</h2>
          {d.meta && <p class="dt-dest__meta">{d.meta}</p>}
          <p class="dt-dest__blurb">{d.prose.blurb}</p>
          {d.href ? (
            <Button variant="outline" href={d.href}>{d.prose.ctaLabel}</Button>
          ) : (
            <span class="dt-dest__todo">[href TODO: {d.tourKey}]</span>
          )}
        </div>
      </div>
    </article>
  ))}
</section>

<!-- WHY PRIVATE (checklist em painel surface) -->
<section class="dt-why">
  <div class="container">
    <div class="dt-why__panel">
      <h2 class="dt-h2">{t.whyPrivate.title}</h2>
      <ul class="dt-why__list">
        {t.whyPrivate.items.map((it) => (
          <li>
            <span class="dt-why__mark" aria-hidden="true">+</span>
            <span>{it}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- FAQ (reusa FAQ.astro; accordion FAQPage-ready) -->
<FAQ lang={lang} title={t.faqTitle} subtitle="" questions={faqQuestions} />

<!-- FINAL CTA (bone + solid-navy; NÃO é um segundo âmbar) -->
<section class="dt-final">
  <div class="container dt-final__inner">
    <h2 class="dt-h2">{t.finalCta.title}</h2>
    <p class="dt-final__text">{t.finalCta.text}</p>
    <Button variant="solid-navy" size="lg" href={quoteHref}>{t.finalCta.ctaLabel}</Button>
  </div>
</section>

<style>
  /* ---- HERO: banda navy TERMINAL (par AA --color-base-dark / --color-on-blue, doc §2) ---- */
  .dt-hero {
    background: var(--color-base-dark);
    color: var(--color-on-blue);
    padding-block: calc(var(--space-2xl) + var(--space-m)) var(--space-2xl);
  }
  .dt-hero__inner {
    max-width: clamp(40rem, 78vw, 56rem);
    text-align: center;
  }
  .dt-hero__title {
    /* H1 hero canônico (doc §3): 33→56px. Antes herdava --font-size-h1 (bridge) do global. */
    font-size: clamp(2.0625rem, 1.529rem + 2.19vw, 3.5rem);
    color: var(--color-on-blue);
    margin: 0 0 var(--space-s);
  }
  .dt-hero__subtitle {
    /* Lead canônico (doc §3): 15→19px. Antes --text-1 (21.6→25px). */
    font-size: clamp(0.9375rem, 0.8446rem + 0.381vw, 1.1875rem);
    line-height: var(--line-normal);
    color: color-mix(in srgb, var(--color-on-blue) 88%, transparent);
    margin: 0 auto var(--space-xl);
    max-width: 48ch;
  }
  .dt-hero__actions {
    display: flex;
    gap: var(--space-s);
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
  }
  /* Secundário 'destinations': ghost bone sobre navy (escopado; não toca Button/global) */
  .dt-hero__ghost {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: var(--space-m);
    border-radius: var(--radius);
    border: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 55%, transparent);
    color: var(--color-on-blue);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition:
      background-color var(--transition-duration-normal) var(--transition-easing-default),
      border-color var(--transition-duration-normal) var(--transition-easing-default);
  }
  @media (hover: hover) {
    .dt-hero__ghost:hover {
      background-color: color-mix(in srgb, var(--color-on-blue) 12%, transparent);
      border-color: var(--color-on-blue);
    }
  }
  .dt-hero__ghost:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-on-blue);
    outline-offset: var(--focus-outline-offset);
  }

  /* ---- TRUST BAR: faixa branca (surface) com hairline embaixo, entre hero e intro.
       Centralizada, flex-wrap no mobile. Zero âmbar. Nota/support canônico. ---- */
  .dt-trust {
    background: var(--color-surface);
    border-block-end: var(--border-width-hairline) solid var(--color-border);
  }
  .dt-trust__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs) var(--space-s);
    padding-block: var(--space-s);
    font-family: var(--font-body);
    /* Nota/support canônico (doc §3): 12.5→14px. */
    font-size: clamp(0.78125rem, 0.7464rem + 0.143vw, 0.875rem);
    color: var(--color-text-muted);
  }
  .dt-trust__item--rating {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }
  .dt-trust__sub {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
  }
  .dt-trust__div {
    inline-size: var(--border-width-hairline);
    block-size: 1rem;
    background: var(--color-border);
  }

  /* ---- Sequência de superfícies (doc §2): navy → branco(trust) → bone → branco(mood)
       → bone → azul → FAQ → bone. Nenhuma corre por mais de 2 seções seguidas. ---- */
  .dt-intro,
  .dt-destinations {
    background: var(--color-base);
    color: var(--color-text);
    padding-block: var(--space-3xl);
  }

  /* MOOD: banda branca (surface). Cards ficam surface + hairline border — a borda
     os define sobre o branco (doc §5 + §1.4: card é borda, não elevação). */
  .dt-mood {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-3xl);
  }

  /* WHY: única faixa azul do corpo, full-bleed (clímax visual). Conteúdo on-blue. */
  .dt-why {
    background: var(--color-blue);
    color: var(--color-on-blue);
    padding-block: var(--space-3xl);
  }

  .dt-h2 {
    /* H2 de seção canônico (doc §3): 26→32px. Antes herdava --font-size-h2 (bridge) do global. */
    font-size: clamp(1.625rem, 1.486rem + 0.571vw, 2rem);
    color: var(--color-text);
  }

  /* ---- INTRO ---- */
  .dt-intro__inner {
    margin: 0 auto;
  }
  .dt-kicker {
    color: var(--color-blue);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    /* Eyebrow canônico (doc §3): 10→11px. Antes --text--1 (15→16px). */
    font-size: clamp(0.625rem, 0.6018rem + 0.0952vw, 0.6875rem);
    margin: 0 0 var(--space-2xs);
  }
  .dt-intro__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .dt-intro__copy p {
    color: var(--color-text-muted);
    line-height: var(--line-normal);
    margin: 0;
    /* Corpo canônico (doc §3): 15→17px. Antes --text-1 (21.6→25px). */
    font-size: clamp(0.9375rem, 0.8911rem + 0.19vw, 1.0625rem);
  }

  /* ---- MOOD MENU ---- */
  .dt-mood__grid {
    list-style: none;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .dt-mood__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-m);
    background: var(--color-surface);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      transform var(--transition-duration-normal) var(--transition-easing-default),
      border-color var(--transition-duration-normal) var(--transition-easing-default);
  }
  @media (hover: hover) {
    .dt-mood__card:hover {
      transform: translateY(-3px);
      border-color: var(--color-blue);
    }
  }
  .dt-mood__label {
    font-family: var(--font-display);
    /* Título de card canônico (doc §3): 15→18px. Antes --text-1 (21.6→25px). */
    font-size: clamp(0.9375rem, 0.8679rem + 0.286vw, 1.125rem);
    color: var(--color-blue);
  }
  .dt-mood__text {
    color: var(--color-text-muted);
    line-height: var(--line-normal);
    /* Nota/support canônico (doc §3): 12.5→14px. Antes herdava corpo default. */
    font-size: clamp(0.78125rem, 0.7464rem + 0.143vw, 0.875rem);
  }

  /* ---- DESTINATIONS (alternando foto/texto) ---- */
  /* Linha full-bleed: imagem sangra num lado, texto respira no outro (gutter).
     Assimétrica 1fr : 1.15fr; alterna o lado a cada linha. */
  .dt-dest {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: stretch;
    min-block-size: 24rem;
    scroll-margin-top: 6rem;
  }
  .dt-dest + .dt-dest {
    margin-top: var(--space-2xl);
  }
  /* Linha par: inverte (imagem à direita) — grid espelhado + ordem da mídia. */
  .dt-dest:nth-child(even) {
    grid-template-columns: 1.15fr 1fr;
  }
  .dt-dest:nth-child(even) .dt-dest__media {
    order: 2;
  }
  /* Mídia: colide com a borda no seu lado, altura mínima 24rem. */
  .dt-dest__media {
    position: relative;
    min-block-size: 24rem;
    overflow: hidden;
  }
  .dt-dest__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Número grande em serif atrás/na imagem, baixo contraste. */
  .dt-dest__num {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-m);
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 6vw, 8rem);
    line-height: 1;
    color: color-mix(in srgb, var(--color-on-blue) 22%, transparent);
    pointer-events: none;
  }
  /* Bloco de texto: centralizado no seu lado, com gutter (a imagem sangrou). */
  .dt-dest__body {
    display: flex;
    align-items: center;
  }
  .dt-dest__inner {
    max-width: 40rem;
    padding: var(--space-xl) var(--gutter);
    /* Alinha o texto ao lado EXTERNO da coluna (oposto à imagem que sangra), para
       o padding-inline var(--gutter) do inner virar o gutter contra a borda da
       página. Linha padrão (texto à direita): empurra p/ a direita. O padding
       interno fica inalterado — o gutter que faltava é só o do lado de fora. */
    margin-inline-start: auto;
  }
  /* Linha par (texto à esquerda): externo é a borda esquerda — volta ao flex-start. */
  .dt-dest:nth-child(even) .dt-dest__inner {
    margin-inline-start: 0;
    margin-inline-end: auto;
  }
  .dt-dest__eyebrow {
    font-family: var(--font-body);
    /* Eyebrow canônico (doc §3): 10→11px. */
    font-size: clamp(0.625rem, 0.6018rem + 0.0952vw, 0.6875rem);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-blue);
    margin: 0 0 var(--space-2xs);
  }
  .dt-dest__name {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    /* Título do destino: escala H de seção do doc §3 (26→32px), serif. */
    font-size: clamp(1.625rem, 1.486rem + 0.571vw, 2rem);
    color: var(--color-text);
  }
  .dt-dest__meta {
    /* Meta (duração · preço): nota canônica (doc §3), 12.5→14px. */
    font-size: clamp(0.78125rem, 0.7464rem + 0.143vw, 0.875rem);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-s);
  }
  .dt-dest__blurb {
    color: var(--color-text-muted);
    line-height: var(--line-normal);
    margin: 0 0 var(--space-m);
    /* Nota/support canônico (doc §3): 12.5→14px. */
    font-size: clamp(0.78125rem, 0.7464rem + 0.143vw, 0.875rem);
  }
  .dt-dest__todo {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ---- WHY PRIVATE ---- */
  /* Painel dissolvido: sobre a faixa azul full-bleed, o conteúdo é só centrado
     (sem card/borda/fundo — a própria banda é o clímax). */
  .dt-why__panel {
    max-width: 60rem;
    margin: 0 auto;
  }
  .dt-why__panel .dt-h2 {
    color: var(--color-on-blue);
    text-align: center;
    margin-top: 0;
    margin-bottom: var(--space-xl);
  }
  .dt-why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .dt-why__list li {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    color: color-mix(in srgb, var(--color-on-blue) 88%, transparent);
    line-height: var(--line-normal);
  }
  /* Mark invertido: bone sobre azul (o azul do fundo o esconderia). */
  .dt-why__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 1.75rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    background: var(--color-on-blue);
    color: var(--color-blue);
    font-weight: var(--font-weight-bold);
  }

  /* ---- FINAL CTA (bone, como HomeFinalCTA) ---- */
  .dt-final {
    background: var(--color-base);
    color: var(--color-text);
    padding-block: var(--space-3xl);
  }
  .dt-final__inner {
    max-width: 52rem;
    margin: 0 auto;
    text-align: center;
  }
  .dt-final .dt-h2 {
    margin-top: 0;
  }
  .dt-final__text {
    color: var(--color-text-muted);
    line-height: var(--line-normal);
    /* Corpo canônico (doc §3): 15→17px. Antes --text-1 (21.6→25px). */
    font-size: clamp(0.9375rem, 0.8911rem + 0.19vw, 1.0625rem);
    margin: var(--space-s) auto var(--space-xl);
    max-width: 54ch;
  }

  /* ---- Responsivo ---- */
  @media (max-width: 768px) {
    .dt-intro,
    .dt-mood,
    .dt-destinations,
    .dt-why,
    .dt-final {
