---



import { homeContent } from "../data/homeContent.js";

// Reusável: templates podem passar title/subtitle/questions; sem props, usa a FAQ da home.
const { lang, title, subtitle, questions } = Astro.props;
const fallback = homeContent[lang].faq;
const content = {
  title: title ?? fallback.title,
  subtitle: subtitle ?? fallback.subtitle,
  questions: questions ?? fallback.questions,
};
---

<section class="faq">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{content.title}</h2>
      <p class="section-subtitle">{content.subtitle}</p>
    </div>

    <div class="faq-list">
      {
        content.questions.map((item, index) => (
          <details class="faq-item" name="home-faq" open={index === 0}>
            <summary class="faq-question">
              <span class="faq-question-text">{item.question}</span>
              <span class="faq-icon" aria-hidden="true">
                <svg
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  viewBox="0 0 24 24"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </summary>

            <div class="faq-answer">
              <p class="faq-answer-content">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    --faq-header-max: clamp(40rem, 75vw, 50rem);
    --faq-list-max: clamp(48rem, 80vw, 56.25rem);
    --faq-blur: var(--blur-md);
    --faq-border: var(--border-width-hairline);
    --faq-transition: var(--transition-duration-slow) var(--transition-easing-default);
    --faq-transition-fast: var(--transition-duration-normal) var(--transition-easing-default);
    --faq-hover-bg: color-mix(in srgb, var(--color-ink) 4%, transparent);
    --faq-icon-size: clamp(1.25rem, 2.5vw, 1.5rem);
    --faq-focus-offset: calc(var(--focus-outline-width) * -1);

    padding: var(--space-3xl) 0;
    /* `background` (shorthand) zera o gradiente legado de .faq (@layer themes).
       Bone, alinhado ao resto do miolo. */
    background: var(--color-base);
    /* Separador bone→bone (segue Things, ambos bone) — mesma hairline tematizada
       (--color-hairline). Pertence à seção de baixo p/ evitar linha dupla. */
    border-block-start: var(--border-width-hairline) solid var(--color-hairline);
  }

  .section-header {
    text-align: center;
    max-width: var(--faq-header-max);
    margin: 0 auto var(--space-2xl);
  }

  .section-title {
    /* H2 de seção canônico (doc §3): 26→32px. Antes herdava --font-size-h2 (bridge). */
    font-size: clamp(1.625rem, 1.486rem + 0.571vw, 2rem);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .section-subtitle {
    /* Lead canônico (doc §3): 15→19px. Antes --text-1 (21.6→25px). */
    font-size: clamp(0.9375rem, 0.8446rem + 0.381vw, 1.1875rem);
    color: var(--color-text-muted);
    line-height: var(--line-snug);
  }

  .faq-list {
    max-width: var(--faq-list-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Card em superfície branca/surface — sem glass legado. */
  .faq-item {
    background: var(--color-surface);
    border: var(--faq-border) solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    /* Sem box-shadow (doc §5): card definido por borda, não elevação. */
    transition: border-color var(--faq-transition);
  }

  @media (hover: hover) {
    .faq-item:hover {
      /* Feedback de hover sem sombra: hairline sutilmente reforçada. */
      border-color: var(--color-border);
    }
  }

  /* <summary> nativo: sem marcador, alvo de toque >=44px. */
  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    min-block-size: 2.75rem;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--faq-transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background-color: var(--faq-hover-bg);
  }

  .faq-question:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-blue);
    outline-offset: var(--faq-focus-offset);
  }

  .faq-question-text {
    /* Título de parada canônico (doc §3): 15→18px. Antes --text-1 (21.6→25px). */
    font-size: clamp(0.9375rem, 0.8679rem + 0.286vw, 1.125rem);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    line-height: var(--line-snug);
  }

  /* Ícone chevron em azul estrutural (sem âmbar); gira no estado [open] nativo. */
  /* Chevron em azul estrutural — nunca âmbar. */
  .faq-icon {
    flex-shrink: 0;
    width: var(--faq-icon-size);
    height: var(--faq-icon-size);
    color: var(--color-blue);
    transition: transform var(--faq-transition);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .faq-answer-content {
    /* Corpo canônico (doc §3): 15→17px. Antes herdava corpo default. */
    font-size: clamp(0.9375rem, 0.8911rem + 0.19vw, 1.0625rem);
    color: var(--color-text-muted);
    line-height: var(--line-normal);
    margin: 0;
  }

  @media (max-width: 768px) {
    /* padding-block fica em --space-3xl (base), alinhado ao ritmo mobile das demais
       seções bone (FeaturedTours/WhyUs/Depoimentos/Experiences/Ready) — fronteira
       FAQ→Ready simétrica 3xl/3xl. Sem override de padding aqui. */
    .section-header {
      margin-bottom: var(--space-xl);
    }

    .faq-question {
      padding: var(--space-md);
    }

    .faq-answer {
      padding: 0 var(--space-md) var(--space-md);
    }
    /* Sem override de font-size no mobile: os clamps canônicos já são fluidos 390→1440. */
  }
</style>

