---
/**
 * CostWedge — B1d (primitivo anti-marketplace, sobre banda azul). Reusa SectionHeader (B1a).
 * Supersede a versão biblioteca (passo 3, não usada). Per-tour, 100% data-driven.
 * Primitivo isolado: o wire com números reais do operador é o B2.
 *
 * Banda azul #2A4F91 full-width, CONSTANTE em light E dark → texto bone. Contraste é
 * ESTRUTURAL (painéis/hierarquia), não via âmbar. Selos, números e totais todos neutros/bone.
 *
 * DISCIPLINA DO ÂMBAR: ZERO âmbar exceto o CTA (Button variant="book"). No B2 este é o
 * âmbar #2 da home (nav + hero + wedge = teto 3; CTA final da home sai outline).
 *
 * Props (nada hardcodado):
 *   tour, title, intro, allInItems[] (string label), allInTotal,
 *   marketplaceItems[] ({label, price} | {label, kind:"base"} | {label, kind:"time"}),
 *   marketplaceTotal, currency, ctaLabel, ctaHref, note.
 */
import SectionHeader from "./SectionHeader.astro";
import Button from "./Button.astro";

const {
  tour,
  title = "O preço honesto, lado a lado",
  intro,
  allInItems = [],
  allInTotal,
  marketplaceItems = [],
  marketplaceTotal = null,         // null → enquadramento valor (sem total numérico)
  currency = "USD",
  ctaLabel = "Reservar o tudo-incluso",
  ctaHref = "#",
  note = "Preços ilustrativos, por pessoa, grupo de dois. Sua tour page mostra o detalhe exato antes de pagar.",
  // strings localizáveis (defaults PT p/ a harness do B1d)
  allInHeading = "Com a Be Free — tudo incluso",
  allInLead = "Uma conta, nada a somar.",
  allInSub = "Guia, transporte e ingressos num preço só — confirmado antes do passeio.",
  allInTotalLabel = "Total hoje",
  allInFoot = "Sem extras na hora. O que você vê é o que paga.",
  marketplaceHeading = "Peça por peça — marketplace",
  marketplaceLead = "Um preço-base tentador…",
  marketplaceSub = "…que vira outro quando você soma ingressos, extras e o tempo na fila.",
  marketplaceTotalLabel = "Total real",
  marketplaceTotalNote = "Preço-base à parte + ingressos acima + a fila — soma que só aparece no fim.",
  marketplaceFoot = "Antes de contar o tempo perdido entre filas e bilheterias.",
} = Astro.props;
---

<section class="cost-wedge" aria-label={tour ? `Comparativo de custo — ${tour}` : "Comparativo de custo"}>
  <div class="container">
    <SectionHeader title={title} intro={intro} />

    <div class="cost-wedge__cols">
      <!-- ESQ: TUDO INCLUSO (recomendada, painel mais sólido) -->
      <div class="cw-panel cw-panel--allin">
        <header class="cw-panel__head">
          <h3 class="cw-panel__title">{allInHeading}</h3>
          <p class="cw-panel__lead">{allInLead}</p>
          <p class="cw-panel__sub">{allInSub}</p>
        </header>

        <ul class="cw-list">
          {allInItems.map((label) => (
            <li class="cw-row cw-row--in">
              <svg class="cw-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span class="cw-row__body"><span class="cw-row__label">{label}</span><span class="cw-tag cw-tag--in">incluso</span></span>
            </li>
          ))}
        </ul>

        <div class="cw-total">
          <span class="cw-total__label">{allInTotalLabel}</span>
          <span class="cw-total__value cw-total__value--strong">
            <span class="cw-cur">{currency}</span>{allInTotal}
          </span>
        </div>
        <p class="cw-foot">{allInFoot}</p>
      </div>

      <!-- DIR: PEÇA POR PEÇA / MARKETPLACE (painel outline, mais flat) -->
      <div class="cw-panel cw-panel--mkt">
        <header class="cw-panel__head">
          <h3 class="cw-panel__title">{marketplaceHeading}</h3>
          <p class="cw-panel__lead">{marketplaceLead}</p>
          <p class="cw-panel__sub">{marketplaceSub}</p>
        </header>

        <ul class="cw-list">
          {marketplaceItems.map((it) => (
            <li class={`cw-row ${it.kind === "time" ? "cw-row--time" : it.kind === "base" ? "cw-row--base" : "cw-row--add"}`}>
              {it.kind !== "base" && <span class="cw-plus" aria-hidden="true">+</span>}
              <span class="cw-row__body"><span class="cw-row__label">{it.label}</span>{it.kind === "time" && <span class="cw-tag cw-tag--time">seu tempo</span>}{(!it.kind || it.kind === "add") && <span class="cw-tag cw-tag--out">não incluso</span>}</span>
              <span class="cw-row__price">
                {it.kind === "time" ? <span class="cw-time">—</span> : it.priceText ? <span class="cw-time">{it.priceText}</span> : (<><span class="cw-cur">{currency}</span>{it.price}</>)}
              </span>
            </li>
          ))}
        </ul>

        {marketplaceTotal != null ? (
          <div class="cw-total">
            <span class="cw-total__label">{marketplaceTotalLabel}</span>
            <span class="cw-total__value cw-total__value--wary">
              <span class="cw-cur">{currency}</span>{marketplaceTotal}
            </span>
          </div>
        ) : (
          <p class="cw-total cw-total--note">{marketplaceTotalNote}</p>
        )}
        <p class="cw-foot">{marketplaceFoot}</p>
      </div>
    </div>

    <div class="cost-wedge__cta">
      <Button variant="book" size="lg" href={ctaHref}>
        {ctaLabel}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </Button>
      <p class="cost-wedge__note">{note}</p>
    </div>
  </div>
</section>

<style>
  /* Banda azul constante nos dois temas; expõe as vars de superfície p/ o SectionHeader. */
  .cost-wedge {
    background-color: var(--color-blue);
    color: var(--color-on-blue);
    padding-block: var(--space-3xl);

    --surface-fg: var(--color-on-blue);
    --surface-fg-muted: color-mix(in srgb, var(--color-on-blue) 82%, transparent);
    --surface-heading: var(--color-on-blue);
  }

  .cost-wedge__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    align-items: stretch;
  }

  .cw-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
    border-radius: var(--radius-lg);
  }

  /* ESQ — recomendada: painel mais sólido (fill + borda mais presente). */
  .cw-panel--allin {
    background: color-mix(in srgb, var(--color-on-blue) 10%, var(--color-blue));
    border: var(--border-width-regular) solid color-mix(in srgb, var(--color-on-blue) 30%, transparent);
  }

  /* DIR — marketplace: mais flat/outline. */
  .cw-panel--mkt {
    background: transparent;
    border: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 18%, transparent);
  }

  .cw-panel__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .cw-panel__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-1);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-on-blue);
  }
  .cw-panel__lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2);
    line-height: var(--line-snug);
    color: var(--color-on-blue);
  }
  .cw-panel__sub {
    margin: 0;
    font-size: var(--text-0);
    line-height: var(--line-snug);
    color: color-mix(in srgb, var(--color-on-blue) 78%, transparent);
  }

  .cw-list {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  /* [ícone/prefixo] e [body] são irmãos numa row que NÃO quebra → o ícone nunca
     se separa do rótulo. O que quebra é o conteúdo do __body (rótulo + selo),
     sempre indentado além do ícone. Preço fica à direita, na 1ª linha. */
  .cw-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    font-size: var(--text-0);
    color: var(--color-on-blue);
  }
  .cw-check {
    flex-shrink: 0;
    margin-block-start: 0.18em; /* alinha à 1ª linha do rótulo */
    color: var(--color-on-blue); /* neutro/bone — nunca âmbar */
  }
  .cw-plus {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--color-on-blue) 70%, transparent);
    font-weight: var(--font-weight-bold);
  }
  .cw-row__body {
    flex: 1 1 auto;
    min-inline-size: 0; /* permite o rótulo quebrar dentro do bloco */
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between; /* wide: selo à direita; narrow: selo quebra p/ baixo-esquerda */
    column-gap: var(--space-2xs);
    row-gap: var(--space-3xs);
  }
  .cw-row__label {
    flex: 1 1 auto;
    min-inline-size: 0; /* o rótulo quebra antes de empurrar o selo */
  }
  .cw-row--time .cw-row__label {
    color: color-mix(in srgb, var(--color-on-blue) 88%, transparent);
  }
  .cw-row__price {
    flex-shrink: 0;
    margin-inline-start: var(--space-s);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-on-blue) 88%, transparent);
  }
  .cw-time { color: color-mix(in srgb, var(--color-on-blue) 55%, transparent); }
  .cw-cur {
    font-size: 0.78em;
    color: color-mix(in srgb, var(--color-on-blue) 70%, transparent);
    margin-inline-end: 0.2em;
  }

  /* Selos/tags — neutros/bone, nunca âmbar. */
  /* Selo: filho do __body, fluxo inline após o rótulo — quebra natural p/ a
     linha de baixo (dentro do body → indentado além do ícone), nunca antes. */
  .cw-tag {
    flex: 0 0 auto;
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: 0.1em 0.55em;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }
  .cw-tag--in {
    background: color-mix(in srgb, var(--color-on-blue) 16%, transparent);
    color: var(--color-on-blue);
  }
  .cw-tag--out,
  .cw-tag--time {
    border: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 30%, transparent);
    color: color-mix(in srgb, var(--color-on-blue) 72%, transparent);
  }

  .cw-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-start: auto;
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 22%, transparent);
  }
  .cw-total__label {
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: color-mix(in srgb, var(--color-on-blue) 78%, transparent);
  }
  .cw-total__value {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cw-total__value--strong {
    font-size: var(--text-4);
    color: var(--color-on-blue);
  }
  .cw-total__value--wary {
    font-size: var(--text-3);
    color: color-mix(in srgb, var(--color-on-blue) 86%, transparent);
  }

  /* Enquadramento valor: sem total numérico (base do marketplace = placeholder). */
  .cw-total--note {
    display: block;
    font-family: var(--font-body);
    font-weight: var(--font-weight-regular);
    font-size: var(--text-0);
    line-height: var(--line-snug);
    color: color-mix(in srgb, var(--color-on-blue) 82%, transparent);
  }

  .cw-foot {
    margin: 0;
    font-size: var(--text--1);
    color: color-mix(in srgb, var(--color-on-blue) 66%, transparent);
  }

  .cost-wedge__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    margin-block-start: var(--space-2xl);
    text-align: center;
  }
  .cost-wedge__note {
    margin: 0;
    max-inline-size: 52ch;
    font-size: var(--text--1);
    color: color-mix(in srgb, var(--color-on-blue) 70%, transparent);
  }

  /* Desktop: duas colunas. */
  @media (min-width: 56rem) {
    .cost-wedge__cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-l);
    }
  }

  /* Mobile: empilha (TUDO INCLUSO primeiro, já é o 1º no DOM); CTA full-width. */
  @media (max-width: 36rem) {
    .cost-wedge__cta :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
