---
/**
 * WhyUs — B2 ("Built around you"). Os moats do Private reautorados sobre bone.
 * SectionHeader assimétrico + grid de razões. A substância de confiança do
 * original é preservada; o ângulo é a flexibilidade de roteiro, o timing sob
 * medida e a privacidade real.
 *
 * O valor "all-inclusive" do original foi RELOCADO pra cunha (HomeCostWedge),
 * sem perda — por isso o card de preço-tudo-incluso sai daqui (filtra icon
 * "travelers"). Ícones em azul estrutural. Âmbar: NÃO (não há CTA de reserva).
 */
import { homeContent } from "../data/homeContent.js";
import SectionHeader from "./SectionHeader.astro";

const { lang } = Astro.props;
const content = (homeContent[lang] ?? homeContent.en).whyUs;

// O all-inclusive (icon "travelers") migra pra cunha — aqui ficam os moats + trust.
const reasons = content.reasons.filter((r) => r.icon !== "travelers");

const icons = {
  calendar:
    '<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
  customize:
    '<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
  guide:
    '<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  star: '<svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>',
  payment:
    '<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>',
};
---

<section class="why-us">
  <div class="container">
    <SectionHeader title={content.title} intro={content.subtitle} />

    <div class="why-grid">
      {reasons.map((reason) => (
        <article class="why-card">
          <span class="why-card__icon" set:html={icons[reason.icon] ?? ""} />
          <h3 class="why-card__title">{reason.title}</h3>
          <p class="why-card__desc">{reason.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us {
    padding-block: var(--space-3xl);
    background-color: var(--color-base);
  }

  .why-grid {
    margin-block-start: var(--space-2xl);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .why-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-l);
    background: var(--color-surface);
    border: var(--border-width-hairline) solid var(--color-hairline);
    border-radius: var(--radius-md);
    transition: transform var(--transition-duration-slow) var(--transition-easing-default),
      box-shadow var(--transition-duration-slow) var(--transition-easing-default);
  }

  @media (hover: hover) {
    .why-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px color-mix(in srgb, var(--color-ink) 12%, transparent);
    }
  }

  /* Ícone azul estrutural — nunca âmbar. */
  .why-card__icon {
    display: inline-flex;
    color: var(--color-blue);
  }

  .why-card__title {
    font-size: var(--text-1);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-snug);
    color: var(--color-text);
    margin: 0;
  }

  .why-card__desc {
    font-size: var(--text-0);
    line-height: var(--line-normal);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
