---
/**
 * FooterEditorial — B1e (primitivo do footer da home, último primitivo do B1).
 * Isolado e props-driven; supersede o Footer.astro atual no B2 (não o toca agora).
 * Absorve o global-amber: ZERO âmbar (links neutros/bone, hover sutil).
 *
 * Superfície: banda navy TERMINAL #0E1A2B, CONSTANTE em light E dark (como o hero/
 * wedge são azul constante). Texto bone (--color-on-blue), secundário mutado.
 * (#0E1A2B = --color-base do tema dark; literal único aqui p/ não alterar
 *  tokens.css/global — no B2 pode virar token --color-base-dark.)
 *
 * Fatos de operador FIXADOS: a linha legal (default) traz CNPJ + "cadastrada no
 * Cadastur" (número UMA vez só). WhatsApp/e-mail entram como links da coluna
 * PLAN WITH US (ícone detectado pelo href). colunas/links/tagline = placeholder
 * no harness; reais e localizados no B2.
 *
 * Logo: slot (precisa de variante cream/clara legível sobre navy — B2). Fallback
 * = wordmark bone.
 *
 * Props: tagline, columns[] ({title, links:[{label, href, note?}]}), legal.
 */
const {
  tagline = "O seu Rio, no seu tempo.",
  columns = [],
  legal = "© 2026 Be Free Tours · Rio de Janeiro · desde 2013 · cadastrada no Cadastur · CNPJ 19.400.673/0001-67 · guias locais licenciados",
} = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__logo">
          <slot name="logo"><span class="footer__wordmark">Be Free Tours</span></slot>
        </div>
        <p class="footer__tagline">{tagline}</p>
      </div>

      <div class="footer__cols">
        {columns.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="footer__col-title">{col.title}</h2>
            <ul class="footer__list">
              {col.links.map((l) => {
                const isWa = typeof l.href === "string" && l.href.startsWith("https://wa.me");
                const isMail = typeof l.href === "string" && l.href.startsWith("mailto:");
                return (
                  <li>
                    <a
                      class="footer__link"
                      href={l.href}
                      target={isWa ? "_blank" : undefined}
                      rel={isWa ? "noopener noreferrer" : undefined}
                    >
                      {isWa && (
                        <svg class="footer__ic" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                      )}
                      {isMail && (
                        <svg class="footer__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                        </svg>
                      )}
                      {isMail ? (
                        <span class="footer__label" set:html={l.label.replace(/([@.])/g, "$1<wbr>")} />
                      ) : (
                        <span class="footer__label">{l.label}</span>
                      )}
                      {l.note && <span class="footer__tag">{l.note}</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <p class="footer__legal">{legal}</p>
  </div>
</footer>

<style>
  /* Banda navy TERMINAL, constante nos dois temas. */
  .footer {
    background-color: #0E1A2B; /* = --color-base (dark), fixado constante */
    color: var(--color-on-blue);
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-2);
    font-weight: var(--font-weight-bold);
    color: var(--color-on-blue);
  }
  .footer__tagline {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: color-mix(in srgb, var(--color-on-blue) 86%, transparent);
    max-inline-size: 28ch;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-m);
  }

  .footer__col {
    min-inline-size: 0; /* nada vaza o padding da banda */
  }

  .footer__col-title {
    margin: 0 0 var(--space-2xs);
    /* Escala de footer reduzida (tipografia secundária): heading fica um tier ABAIXO
       do link (xs ~14px desktop vs text--1 ~16px) — hierarquia preservada, menor. */
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: color-mix(in srgb, var(--color-on-blue) 64%, transparent);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Link neutro/bone, hover sutil. Alvo ≥44px. ZERO âmbar. */
  .footer__link {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap; /* pill desce como unidade quando não cabe ao lado do rótulo */
    gap: var(--space-2xs);
    min-block-size: 2.75rem;
    max-inline-size: 100%; /* link nunca excede a coluna */
    color: color-mix(in srgb, var(--color-on-blue) 82%, transparent);
    text-decoration: none;
    /* Footer = tipografia secundária: link desce de --text-0 (~18-20px) p/ --text--1
       (~15-16px). Encolhe o e-mail na origem, aliviando o aperto da col 4. */
    font-size: var(--text--1);
  }
  /* Rótulo encolhe e quebra DENTRO da coluna (ex.: e-mail longo) — nunca vaza.
     break-word (não `anywhere`): só quebra mid-word em último recurso. O e-mail
     recebe <wbr> após @ e `.` (no markup) → quebra SEMPRE em ponto limpo
     (contact@ / befreetours. / com.), nunca em "befreetour|s". */
  .footer__label {
    min-inline-size: 0;
    overflow-wrap: break-word;
  }
  @media (hover: hover) {
    .footer__link:hover {
      color: var(--color-on-blue);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
  .footer__link:focus-visible {
    outline: var(--border-width-strong) solid var(--color-on-blue);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .footer__ic { flex-shrink: 0; opacity: 0.85; }

  /* "sob consulta" etc. — etiqueta mutada, nunca âmbar. */
  .footer__tag {
    flex-shrink: 0;
    white-space: nowrap; /* texto da pill sempre em 1 linha; a pill inteira é que quebra */
    font-size: var(--font-size-xs); /* proporcional ao heading na escala reduzida */
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: color-mix(in srgb, var(--color-on-blue) 55%, transparent);
    border: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 28%, transparent);
    border-radius: var(--radius-full);
    padding: 0.05em 0.5em;
  }

  .footer__legal {
    margin: var(--space-2xl) 0 0;
    padding-block-start: var(--space-l);
    border-block-start: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 16%, transparent);
    font-size: var(--text--1);
    line-height: var(--line-snug);
    color: color-mix(in srgb, var(--color-on-blue) 60%, transparent);
  }

  /* Desktop: brand à esquerda, colunas (3) à direita. Bloco de colunas recebe peso
     maior (1fr:2fr, era 1.7fr) — a brand tem folga (tagline cap 28ch ~252px numa
     coluna de ~360px), e as colunas precisam da largura p/ o e-mail longo da col3
     sem espremer Tours/Company. */
  @media (min-width: 56rem) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-3xl);
    }
    /* Col 3 (Plan Your Trip) tem o conteúdo mais largo do footer — o e-mail
       (~290px de rótulo + ícone). Recebe peso maior (1.3fr) p/ o e-mail quebrar
       no máximo em 2 linhas LIMPAS (via <wbr>) e o "Payment & Cancellation" caber;
       Tours/Company (122/92px) seguem folgados em 1fr (≥ ~136px em todo desktop).
       Colunas de grid não precisam ser iguais. */
    .footer__cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.3fr);
    }
  }

  /* Mobile estreito: empilha (brand → colunas → legal); colunas em 1 coluna. */
  @media (max-width: 30rem) {
    .footer__cols {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
