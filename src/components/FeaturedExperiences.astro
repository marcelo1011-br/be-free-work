---
/**
 * FeaturedExperiences — B2 ("Things to Do"). Grid de TourCardRich do experiences.js.
 * Superfície bone; SectionHeader assimétrico. Âmbar: NÃO. Basis = por pessoa.
 * Posicionado pra não diluir o caminho primário de tours.
 */
import SectionHeader from "./SectionHeader.astro";
import TourCardRich from "./TourCardRich.astro";
import { experiences } from "../data/experiences.js";
import { getPrice } from "../utils/priceHelper.js";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang);

const segBase = { en: "experiences", es: "experiencias", "pt-br": "experiencias" };
const expBase = `/${lang}/${segBase[lang] ?? segBase.en}`;

const items = (experiences[lang] ?? experiences.en).slice(0, 3);

const personLabel = { en: "/person", es: "/persona", "pt-br": "/pessoa" }[lang] ?? "/person";
const isPT = lang === "pt-br";
const curSymbol = isPT ? "R$" : "US$";
const round5up = (n) => Math.ceil(n / 5) * 5;
const toDisplay = (usd) => (isPT ? round5up(usd * 4.9) : usd);

const cards = await Promise.all(
  items.map(async (item) => {
    const price = getPrice(item, 1, "USD");
    const noPrice = price.basis === "custom" || price.basis === "quote";

    const imageSlug = item.imageSlug || item.slug;
    let img;
    try {
      img = (await import(`../images/tours/cards/${imageSlug}-card.webp`)).default;
    } catch {
      try {
        const baseSlug = item.slug.split("-").slice(0, 2).join("-");
        img = (await import(`../images/tours/cards/${baseSlug}-card.webp`)).default;
      } catch {
        img = (await import(`../images/tours/cards/essential-rio-card.webp`)).default;
      }
    }

    return {
      href: `${expBase}/${item.slug}/`,
      image: img.src,
      imageAlt: item.title,
      eyebrow: "Rio de Janeiro",
      title: item.title,
      description: item.shortDescription,
      inclusions: (item.included || []).slice(0, 3),
      priceFrom: noPrice ? null : toDisplay(price.from),
      priceLabel: noPrice ? t("general.onRequest") : null,
    };
  })
);
---

<section class="featured-experiences">
  <div class="container">
    <SectionHeader
      title={t("featuredExperiences.title")}
      intro={t("featuredExperiences.subtitle")}
      linkHref={expBase}
      linkLabel={t("featuredExperiences.viewAll")}
    />

    <div class="fx-grid">
      {cards.map((c) => (
        <TourCardRich
          href={c.href}
          image={c.image}
          imageAlt={c.imageAlt}
          eyebrow={c.eyebrow}
          title={c.title}
          description={c.description}
          inclusions={c.inclusions}
          priceFrom={c.priceFrom}
          priceLabel={c.priceLabel}
          currency={curSymbol}
          basisLabel={personLabel}
          fromLabel={t("general.fromPrice")}
          ctaLabel={t("general.viewExperience")}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .featured-experiences {
    padding-block: var(--space-3xl);
    background-color: var(--color-base);
  }
  .fx-grid {
    margin-block-start: var(--space-2xl);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
</style>
