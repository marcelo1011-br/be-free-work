---
/**
 * FeaturedExperiences — passo 4 (home reautorada no vocabulário "mar e sol").
 * Lógica intacta: 3 experiências (single-source) via TourCard section="experiences".
 * Âmbar: NÃO. "Ver todas" é outline.
 */
import TourCard from "./TourCard.astro";
import Button from "./Button.astro";
import { experiences } from "../data/experiences.js";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = experiences[lang].slice(0, 3);
const experiencesBase = `/${lang}/${lang === "en" ? "experiences" : "experiencias"}`;
---

<section class="featured-experiences">
  <div class="container">
    <header class="fx-head">
      <h2 class="fx-headline">{t("featuredExperiences.title")}</h2>
      <p class="fx-intro measure">{t("featuredExperiences.subtitle")}</p>
    </header>

    <div class="fx-grid">
      {items.map((item) => (
        <TourCard item={item} lang={lang} section="experiences" />
      ))}
    </div>

    <div class="fx-cta">
      <Button variant="outline" size="lg" href={experiencesBase}>
        {t("featuredExperiences.viewAll")}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </Button>
    </div>
  </div>
</section>

<style>
  .featured-experiences {
    padding-block: var(--space-3xl);
    background-color: var(--color-surface);
  }

  .fx-head {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-2xl);
  }

  .fx-headline {
    font-family: var(--font-display);
    font-size: var(--text-4);
    line-height: var(--line-tight);
    color: var(--color-blue);
    margin: 0;
  }

  .fx-intro {
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: var(--color-text-muted);
    margin: var(--space-s) 0 0;
  }

  .fx-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .fx-cta {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-2xl);
  }

  @media (max-width: 600px) {
    .fx-headline {
      font-size: var(--text-3);
    }
    .fx-cta :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
