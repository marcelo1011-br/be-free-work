---
/**
 * FeaturedTours — B2. Grid de TourCardRich a partir do tours.js (flag isFeatured).
 * Superfície bone; SectionHeader assimétrico (h2 + intro + "ver todos →").
 * Âmbar: NÃO (cards e link neutros). Preço por locale (USD en/es; R$ pt convertido).
 */
import SectionHeader from "./SectionHeader.astro";
import TourCardRich from "./TourCardRich.astro";
import { tours } from "../data/tours.js";
import { getPrice } from "../utils/priceHelper.js";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang);

const routeBySeg = { en: "private-tours", es: "tours-privados", "pt-br": "passeios-privados" };
const toursBase = `/${lang}/${routeBySeg[lang] ?? routeBySeg.en}`;

const featured = (tours[lang] ?? tours.en).filter((tour) => tour.isFeatured);

// Eyebrow de localidade (não há campo no source — derivado; nomes próprios = locale-agnóstico).
const localityBySlug = {
  "essential-rio": "Rio de Janeiro",
  "rio-express": "Rio de Janeiro",
  "first-light-sunrise": "Rio de Janeiro",
  "golden-hour-rio": "Rio de Janeiro",
  "sunset-culture-roxy": "Rio de Janeiro",
  "island-escape-ilha-grande": "Ilha Grande",
  "petropolis-imperial": "Petrópolis",
  "tijuca-rainforest": "Floresta da Tijuca",
  "niteroi-mac-museum": "Niterói",
  "modern-rio-museum-tomorrow": "Rio de Janeiro",
  "custom-tour": "Rio de Janeiro",
};

const basisText = {
  en: { group: "/group", person: "/person", boat: "/boat" },
  es: { group: "/grupo", person: "/persona", boat: "/barco" },
  "pt-br": { group: "/grupo", person: "/pessoa", boat: "/barco" },
}[lang] ?? { group: "/group", person: "/person", boat: "/boat" };

const isPT = lang === "pt-br";
const curSymbol = isPT ? "R$" : "US$";
const round5up = (n) => Math.ceil(n / 5) * 5;
const toDisplay = (usd) => (isPT ? round5up(usd * 4.9) : usd); // PT: USD→BRL ×4,9 arred. 5/0

const cards = await Promise.all(
  featured.map(async (tour) => {
    const price = getPrice(tour, 1, "USD");
    const isBoat = Boolean(tour.pricing?.standard);
    const mappedBasis = isBoat ? "boat" : price.basis === "perPerson" ? "person" : "group";
    const noPrice = price.basis === "custom" || price.basis === "quote";

    const imageSlug = tour.imageSlug || tour.slug;
    let img;
    try {
      img = (await import(`../images/tours/cards/${imageSlug}-card.webp`)).default;
    } catch {
      try {
        const baseSlug = tour.slug.split("-").slice(0, 2).join("-");
        img = (await import(`../images/tours/cards/${baseSlug}-card.webp`)).default;
      } catch {
        img = (await import(`../images/tours/cards/essential-rio-card.webp`)).default;
      }
    }

    return {
      href: `${toursBase}/${tour.slug}/`,
      image: img.src,
      imageAlt: tour.title,
      eyebrow: localityBySlug[tour.slug] ?? "Rio de Janeiro",
      title: tour.title,
      description: tour.shortDescription,
      inclusions: (tour.included || []).slice(0, 3),
      priceFrom: noPrice ? null : toDisplay(price.from),
      priceLabel: noPrice ? t("general.onRequest") : null,
      basisLabel: basisText[mappedBasis],
    };
  })
);
---

<section class="featured-tours">
  <div class="container">
    <SectionHeader
      title={t("featuredTours.title")}
      intro={t("featuredTours.subtitle")}
      linkHref={toursBase}
      linkLabel={t("featuredTours.viewAll")}
    />

    <div class="ft-grid">
      {cards.map((c) => (
        <TourCardRich
          href={c.href}
          image={c.image}
          imageAlt={c.imageAlt}
          eyebrow={c.eyebrow}
          title={c.title}
          description={c.description}
          inclusions={c.inclusions}
          priceFrom={c.priceFrom}
          priceLabel={c.priceLabel}
          currency={curSymbol}
          basisLabel={c.basisLabel}
          fromLabel={t("general.fromPrice")}
          ctaLabel={t("general.viewTour")}
        />
      ))}
    </div>
  </div>
</section>

<style>
  /* `background` (shorthand) zera o gradiente legado de .featured-tours (@layer
     themes, global.css). Scoped unlayered vence o layered → bone limpo. */
  .featured-tours {
    padding-block: var(--space-3xl);
    background: var(--color-base);
  }
  .ft-grid {
    margin-block-start: var(--space-2xl);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
</style>
