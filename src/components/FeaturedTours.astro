---



import TourCard from "./TourCard.astro";
import { tours } from "../data/tours.js";
import { useTranslations } from "../i18n/utils";
const { lang } = Astro.props;
const t = useTranslations(lang);


const featuredTours = tours[lang].filter((tour) => tour.isFeatured);
const [primaryTour, ...secondaryTours] = featuredTours;

const toursBase = `/${lang}/${lang === "en" ? "private-tours" : lang === "es" ? "tours-privados" : "passeios-privados"}`;

const quickFilters = {
  en: [
    { label: "All Tours",     href: toursBase },
    { label: "City Tours",    href: `${toursBase}?category=city-tours` },
    { label: "Day Trips",     href: `${toursBase}?category=day-trips` },
  ],
  es: [
    { label: "Todos los Tours",      href: toursBase },
    { label: "Tours por la Ciudad",  href: `${toursBase}?category=city-tours` },
    { label: "Excursiones de Día",   href: `${toursBase}?category=day-trips` },
  ],
  "pt-br": [
    { label: "Todos os Passeios",       href: toursBase },
    { label: "City Tours",              href: `${toursBase}?category=city-tours` },
    { label: "Passeios de Dia Inteiro", href: `${toursBase}?category=day-trips` },
  ],
};

const filters = quickFilters[lang] ?? quickFilters.en;

const sectionKicker = {
  en: "Signature private tours",
  es: "Tours privados destacados",
  "pt-br": "Passeios privativos em destaque"
};


const tourBadgeMap = {
  en: {
    "The Essential Rio: Icons, Culture & Hidden Gems": "Most Popular",
    "Rio Express: Christ & Sugarloaf in 5 Hours": "Best for Cruise Passengers",
    "Island Escape: Ilha Grande by Private Speedboat": "Private Speedboat",
    "Your Rio, Your Way: Custom Private Tour": "Fully Customizable"
  },
  es: {
    "El Río Esencial: Íconos, Cultura y Joyas Ocultas": "Más Popular",
    "Río Express: Cristo y Pan de Azúcar en 5 Horas": "Ideal para Cruceristas",
    "Escape a la Isla: Ilha Grande en Lancha Privada": "Lancha Privada",
    "Tu Río, a Tu Manera: Tour Privado Personalizado": "Totalmente Personalizable"
  },
  "pt-br": {
    "O Essencial do Rio: Ícones, Cultura e Joias Escondidas": "Mais Popular",
    "Rio Express: Cristo e Pão de Açúcar em 5 Horas": "Ideal para Cruzeiros",
    "Escapada para a Ilha: Ilha Grande de Lancha Privativa": "Lancha Privada",
    "Seu Rio, do Seu Jeito: Passeio Privado Personalizado": "Totalmente Personalizável"
  }
};
---



<section class="featured-tours">
  <div class="container-wide">
    <div class="featured-tours-header">
      <p class="editorial-kicker">{sectionKicker[lang] ?? sectionKicker.en}</p>
      <h2 class="section-title">{t("featuredTours.title")}</h2>
      <p class="section-subtitle measure-wide">{t("featuredTours.subtitle")}</p>
    </div>

    <div class="featured-tour-layout">
      {primaryTour && (
        <div class="featured-tour-primary">
          <TourCard
            tour={primaryTour}
            lang={lang}
            badge={tourBadgeMap[lang]?.[primaryTour.id]}
          />
        </div>
      )}

      <div class="featured-tour-secondary">
        {secondaryTours.map((tour) => (
          <div class="featured-tour-secondary__item">
            <TourCard
              tour={tour}
              lang={lang}
              badge={tourBadgeMap[lang]?.[tour.id]}
            />
          </div>
        ))}
      </div>
    </div>

    {/* QUICK FILTERS - TEMPORARIAMENTE DESATIVADO
    <nav class="quick-filters" aria-label={lang === "en" ? "Browse by category" : lang === "es" ? "Filtrar por categoría" : "Filtrar por categoria"}>
      {filters.map((f, i) => (
        <span class="qf-item">
          {i > 0 && <span class="qf-sep" aria-hidden="true">·</span>}
          <a href={f.href} class="qf-link">{f.label}</a>
        </span>
      ))}
    </nav>
    */}

    <div class="section-cta">
      <a
        href={toursBase}
        class="btn btn-outline-primary btn-lg"
      >
        {t("featuredTours.viewAll")}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured-tours {
    --section-subtitle-max: clamp(40rem, 75vw, 50rem);
    --cta-btn-gap: var(--space-xs);

    padding: var(--section-space-lg) 0;
    background-color: var(--color-bg-alt);
  }

  .featured-tours-header {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: end;
    margin-bottom: var(--space-2xl);
  }

  .featured-tours-header .editorial-kicker {
    grid-column: 1 / -1;
  }

  .section-title {
    color: var(--color-text);
    margin: 0;
  }

  .section-subtitle {
    font-size: var(--font-size-h5);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin: 0;
    justify-self: end;
  }

  .featured-tour-layout {
    display: grid;
    grid-template-columns: minmax(20rem, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
    align-items: stretch;
  }

  .featured-tour-primary,
  .featured-tour-secondary__item {
    min-width: 0;
  }

  .featured-tour-primary :global(.tour-card),
  .featured-tour-secondary__item :global(.tour-card) {
    height: 100%;
  }

  .featured-tour-primary :global(.tour-card) {
    box-shadow: 0 24px 60px color-mix(in srgb, black 22%, transparent);
  }

  .featured-tour-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  /* QUICK FILTERS - TEMPORARIAMENTE DESATIVADO
  .quick-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .qf-item {
    display: flex;
    align-items: center;
  }

  .qf-sep {
    color: var(--color-border);
    padding: 0 var(--space-2xs);
    user-select: none;
  }

  .qf-link {
    font-size: var(--font-size-small);
    color: var(--color-text-light);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-sm);
    border-radius: clamp(0.25rem, 0.5vw, 0.375rem);
    transition: color var(--transition-duration-slow) var(--transition-easing-default);
  }

  .qf-link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  */

  .section-cta {
    text-align: center;
  }

  .section-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--cta-btn-gap);
  }

  .featured-tours .section-cta .btn-outline-primary {
    border-color: transparent;
  }

  .featured-tours .section-cta .btn-outline-primary:focus,
  .featured-tours .section-cta .btn-outline-primary:focus-visible {
    outline: none;
    box-shadow: none;
  }

  
  @media (max-width: 768px) {
    .featured-tours {
      padding: var(--section-space-md) 0;
    }

    .featured-tours-header,
    .featured-tour-layout,
    .featured-tour-secondary {
      grid-template-columns: 1fr;
    }

    .featured-tours-header {
      gap: var(--space-md);
      margin-bottom: var(--space-xl);
    }

    .section-subtitle {
      font-size: var(--font-size-body);
      justify-self: stretch;
    }
  }
</style>
