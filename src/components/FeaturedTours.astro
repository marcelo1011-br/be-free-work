---
/**
 * FeaturedTours — passo 4 (home reautorada no vocabulário "mar e sol").
 * Lógica intacta: tours em destaque (single-source) + TourCard + badges por locale.
 * Âmbar: NÃO. "Ver todos" é outline; cards nunca pintam âmbar.
 */
import TourCard from "./TourCard.astro";
import Button from "./Button.astro";
import { tours } from "../data/tours.js";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang);

const featuredTours = tours[lang].filter((tour) => tour.isFeatured);

const toursBase = `/${lang}/${lang === "en" ? "private-tours" : lang === "es" ? "tours-privados" : "passeios-privados"}`;

const tourBadgeMap = {
  en: {
    "The Essential Rio: Icons, Culture & Hidden Gems": "Most Popular",
    "Rio Express: Christ & Sugarloaf in 5 Hours": "Best for Cruise Passengers",
    "Island Escape: Ilha Grande by Private Speedboat": "Private Speedboat",
    "Your Rio, Your Way: Custom Private Tour": "Fully Customizable"
  },
  es: {
    "El Río Esencial: Íconos, Cultura y Joyas Ocultas": "Más Popular",
    "Río Express: Cristo y Pan de Azúcar en 5 Horas": "Ideal para Cruceristas",
    "Escape a la Isla: Ilha Grande en Lancha Privada": "Lancha Privada",
    "Tu Río, a Tu Manera: Tour Privado Personalizado": "Totalmente Personalizable"
  },
  "pt-br": {
    "O Essencial do Rio: Ícones, Cultura e Joias Escondidas": "Mais Popular",
    "Rio Express: Cristo e Pão de Açúcar em 5 Horas": "Ideal para Cruzeiros",
    "Escapada para a Ilha: Ilha Grande de Lancha Privativa": "Lancha Privada",
    "Seu Rio, do Seu Jeito: Passeio Privado Personalizado": "Totalmente Personalizável"
  }
};
---

<section class="featured-tours">
  <div class="container">
    <header class="ft-head">
      <h2 class="ft-headline">{t("featuredTours.title")}</h2>
      <p class="ft-intro measure">{t("featuredTours.subtitle")}</p>
    </header>

    <div class="ft-grid">
      {featuredTours.map((tour) => (
        <TourCard
          tour={tour}
          lang={lang}
          badge={tourBadgeMap[lang]?.[tour.id]}
        />
      ))}
    </div>

    <div class="ft-cta">
      <Button variant="outline" size="lg" href={toursBase}>
        {t("featuredTours.viewAll")}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </Button>
    </div>
  </div>
</section>

<style>
  .featured-tours {
    padding-block: var(--space-3xl);
    background-color: var(--color-base);
  }

  .ft-head {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-2xl);
  }

  .ft-headline {
    font-family: var(--font-display);
    font-size: var(--text-4);
    line-height: var(--line-tight);
    color: var(--color-blue);
    margin: 0;
  }

  .ft-intro {
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: var(--color-text-muted);
    margin: var(--space-s) 0 0;
  }

  .ft-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .ft-cta {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-2xl);
  }

  @media (max-width: 600px) {
    .ft-headline {
      font-size: var(--text-3);
    }
    .ft-cta :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
