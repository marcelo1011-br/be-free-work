---
/**
 * AllIncludedTeaser — faixa fina que afunila pra /all-included/ (BIBLIOTECA p/ passo 4).
 * Link ghost/texto (NÃO âmbar). Alvo via routes.js (404a no preview até o passo 4 — esperado).
 */
import { useTranslations } from "../i18n/utils";
import { routes } from "../i18n/routes.js";

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
---

<a href={`/${lang}${r.allIncluded}`} class="ai-teaser">
  <span class="ai-teaser__text">{t("teaser.allIncluded")}</span>
</a>

<style>
  .ai-teaser {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--gutter);
    background: color-mix(in srgb, var(--color-blue) 10%, var(--color-base));
    border-block: var(--border-width-hairline) solid var(--color-hairline);
    color: var(--color-blue);
    text-decoration: none;
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    min-block-size: 2.75rem;
    transition: background-color var(--transition-duration-normal) var(--transition-easing-default);
  }
  .ai-teaser:hover {
    background: color-mix(in srgb, var(--color-blue) 16%, var(--color-base));
  }
  :global([data-theme="dark"]) .ai-teaser {
    color: var(--color-on-blue);
  }
</style>
