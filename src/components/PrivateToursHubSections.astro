---
import { privateToursHubContent } from "../data/privateToursHubContent.js";

const { lang = "en", showFaqOnly = false } = Astro.props;
const content = privateToursHubContent[lang] || privateToursHubContent.en;
---

{!showFaqOnly && (
  <>
    <section class="private-tours-action" aria-label="Private tour planning actions">
      <div class="container-editorial">
        <div class="action-card">
          <a href={content.cta.primaryHref} class="btn btn-primary btn-lg">
            {content.cta.primaryLabel}
          </a>
          <a href={content.cta.secondaryHref} class="btn btn-outline-primary btn-lg">
            {content.cta.secondaryLabel}
          </a>
          <a href={content.cta.listHref} class="tour-list-shortcut">
            {content.cta.listLabel}
          </a>
        </div>
      </div>
    </section>

    <section class="private-tours-difference">
      <div class="container-wide">
        <div class="difference-layout">
          <div class="section-heading section-heading-editorial">
            <h2>{content.differentiators.title}</h2>
          </div>
          <div class="difference-list">
            {content.differentiators.items.map((item, index) => (
              <article class="difference-card">
                <span class="difference-number">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="private-tours-chooser">
      <div class="container-editorial">
        <div class="chooser-layout">
          <div class="section-heading section-heading-editorial">
            <h2>{content.chooser.title}</h2>
            <p>{content.chooser.intro}</p>
          </div>
          <div class="chooser-guide">
            {content.chooser.cards.map((card, index) => (
              <article class="chooser-card">
                <span class="chooser-index">{String(index + 1).padStart(2, "0")}</span>
                <div class="chooser-card-content">
                  <span class="chooser-label">{card.label}</span>
                  <p>{card.text}</p>
                  <div class="chooser-links">
                    {card.links.map((link) => (
                      <a href={link.href}>{link.label}</a>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </>
)}

{showFaqOnly && (
  <section class="private-tours-faq">
    <div class="container">
      <div class="section-heading">
        <h2>{content.faq.title}</h2>
      </div>
      <div class="faq-list">
        {content.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .private-tours-action,
  .private-tours-difference,
  .private-tours-chooser,
  .private-tours-faq {
    background: var(--color-bg-white);
  }

  .private-tours-action {
    padding: var(--section-space-sm) 0 0;
  }

  .action-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding: clamp(1rem, 2.5vw, 1.5rem) 0;
    border-top: var(--border-width-hairline) solid var(--glass-border);
    border-bottom: var(--border-width-hairline) solid var(--glass-border);
  }

  .tour-list-shortcut {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .private-tours-difference,
  .private-tours-chooser {
    padding: var(--section-space-md) 0 0;
  }

  .private-tours-faq {
    padding: 0 0 var(--space-3xl);
  }

  .section-heading {
    max-width: 56rem;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .section-heading-editorial {
    max-width: var(--content-measure-wide);
    margin: 0;
    text-align: left;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-text);
  }

  .section-heading p {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .difference-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .difference-list {
    display: grid;
    gap: 0;
    border-top: var(--border-width-hairline) solid var(--color-border);
  }

  .chooser-layout {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .chooser-guide {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: var(--space-md);
    align-items: start;
  }

  .difference-card,
  .faq-list details {
    border: var(--border-width-hairline) solid var(--color-border);
    background: var(--color-bg-soft);
  }

  .difference-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-md);
    padding: clamp(1.1rem, 2vw, 1.5rem) 0;
    border-width: 0 0 var(--border-width-hairline);
    background: transparent;
  }

  .difference-card h3,
  .chooser-card p {
    margin: 0;
  }

  .difference-card h3 {
    font-size: var(--font-size-h6);
    color: var(--color-text);
  }

  .difference-number,
  .chooser-index {
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0;
  }

  .difference-card p {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .chooser-card {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--space-md);
    min-height: 100%;
    padding: clamp(1.15rem, 2vw, 1.5rem);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
  }

  .chooser-card:nth-child(-n + 3) {
    grid-column: 1;
  }

  .chooser-card:nth-child(n + 4) {
    grid-column: 2;
    background: transparent;
  }

  .chooser-card-content {
    min-width: 0;
  }

  .chooser-label {
    display: inline-block;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .chooser-card p {
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .chooser-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .chooser-links a {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .faq-list {
    max-width: 56rem;
    margin: 0 auto;
    display: grid;
    gap: var(--space-sm);
  }

  .faq-list details {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
  }

  .faq-list summary {
    cursor: pointer;
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .faq-list p {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 1100px) {
    .difference-layout {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .chooser-guide {
      grid-template-columns: 1fr;
    }

    .chooser-card:nth-child(-n + 3),
    .chooser-card:nth-child(n + 4) {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    .private-tours-difference,
    .private-tours-chooser {
      padding-top: var(--section-space-sm);
    }

    .private-tours-faq {
      padding-bottom: var(--space-2xl);
    }

    .difference-card,
    .chooser-card {
      grid-template-columns: 2.35rem minmax(0, 1fr);
      gap: var(--space-sm);
    }

    .chooser-guide {
      gap: 0;
      border-top: var(--border-width-hairline) solid var(--color-border);
    }

    .chooser-card {
      padding: var(--space-md) 0;
      border-width: 0 0 var(--border-width-hairline);
      border-radius: 0;
      background: transparent;
    }

    .action-card {
      align-items: stretch;
      flex-direction: column;
      padding-inline: 0;
    }

    .tour-list-shortcut {
      text-align: center;
    }
  }
</style>
