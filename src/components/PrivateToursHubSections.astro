---
import { privateToursHubContent } from "../data/privateToursHubContent.js";

const { lang = "en", showFaqOnly = false } = Astro.props;
const content = privateToursHubContent[lang] || privateToursHubContent.en;
---

{!showFaqOnly && (
  <>
    <section class="private-tours-action" aria-label="Private tour planning actions">
      <div class="container">
        <div class="action-card">
          <a href={content.cta.primaryHref} class="btn btn-primary btn-lg">
            {content.cta.primaryLabel}
          </a>
          <a href={content.cta.secondaryHref} class="btn btn-outline-primary btn-lg">
            {content.cta.secondaryLabel}
          </a>
          <a href={content.cta.listHref} class="tour-list-shortcut">
            {content.cta.listLabel}
          </a>
        </div>
      </div>
    </section>

    <section class="private-tours-difference">
      <div class="container">
        <div class="section-heading">
          <h2>{content.differentiators.title}</h2>
        </div>
        <div class="difference-grid">
          {content.differentiators.items.map((item) => (
            <article class="difference-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="private-tours-chooser">
      <div class="container">
        <div class="section-heading">
          <h2>{content.chooser.title}</h2>
          <p>{content.chooser.intro}</p>
        </div>
        <div class="chooser-grid">
          {content.chooser.cards.map((card) => (
            <article class="chooser-card">
              <span class="chooser-label">{card.label}</span>
              <p>{card.text}</p>
              <div class="chooser-links">
                {card.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </>
)}

{showFaqOnly && (
  <section class="private-tours-faq">
    <div class="container">
      <div class="section-heading">
        <h2>{content.faq.title}</h2>
      </div>
      <div class="faq-list">
        {content.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .private-tours-action,
  .private-tours-difference,
  .private-tours-chooser,
  .private-tours-faq {
    background: var(--color-bg-white);
  }

  .private-tours-action {
    padding: var(--space-xl) 0 0;
  }

  .action-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding: var(--space-lg);
    background: var(--glass-bg);
    border: var(--border-width-hairline) solid var(--glass-border);
    border-radius: var(--radius-md);
    box-shadow: var(--glass-shadow);
  }

  .tour-list-shortcut {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .private-tours-difference,
  .private-tours-chooser {
    padding: var(--space-2xl) 0 0;
  }

  .private-tours-faq {
    padding: 0 0 var(--space-3xl);
  }

  .section-heading {
    max-width: 56rem;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-text);
  }

  .section-heading p {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .difference-grid,
  .chooser-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .chooser-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .difference-card,
  .chooser-card,
  .faq-list details {
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
  }

  .difference-card,
  .chooser-card {
    padding: var(--space-lg);
  }

  .difference-card h3,
  .chooser-card p {
    margin: 0;
  }

  .difference-card h3 {
    font-size: var(--font-size-h6);
    color: var(--color-text);
  }

  .difference-card p {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .chooser-label {
    display: inline-block;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }

  .chooser-card p {
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .chooser-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .chooser-links a {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .faq-list {
    max-width: 56rem;
    margin: 0 auto;
    display: grid;
    gap: var(--space-sm);
  }

  .faq-list details {
    padding: var(--space-md) var(--space-lg);
  }

  .faq-list summary {
    cursor: pointer;
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .faq-list p {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 1100px) {
    .difference-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chooser-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .private-tours-difference,
    .private-tours-chooser {
      padding-top: var(--space-xl);
    }

    .private-tours-faq {
      padding-bottom: var(--space-2xl);
    }

    .difference-grid,
    .chooser-grid {
      grid-template-columns: 1fr;
    }

    .action-card {
      align-items: stretch;
      flex-direction: column;
    }

    .tour-list-shortcut {
      text-align: center;
    }
  }
</style>
