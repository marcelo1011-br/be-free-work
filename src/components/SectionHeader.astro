---
/**
 * SectionHeader — B1a (primitivo da linguagem editorial do redesign).
 *
 * Cabeçalho de seção ASSIMÉTRICO: título serif (Newsreader) grande à esquerda +
 * parágrafo de intro deslocado à direita (alinhado embaixo) + link "ver tudo →"
 * opcional. Fluido (clamp). Consome as variáveis --surface-* da superfície que o
 * envolve (.surface-bone / .surface-blue) com fallback p/ tokens — funciona nas
 * duas superfícies e em light/dark.
 *
 * Sem âmbar (não há CTA de reserva aqui). O link é ghost/estrutural.
 *
 * Props: kicker?, title (obrigatório), intro?, linkHref?, linkLabel?
 * Slot "link" sobrescreve o link padrão quando algo custom for necessário.
 */
const { kicker, title, intro, linkHref, linkLabel } = Astro.props;
const hasLinkSlot = Astro.slots.has("link");
const showAside = Boolean(intro || linkHref || hasLinkSlot);
---

<header class="section-header">
  <div class="section-header__lead">
    {kicker && <p class="section-header__kicker">{kicker}</p>}
    <h2 class="section-header__title">{title}</h2>
  </div>

  {showAside && (
    <div class="section-header__aside">
      {intro && <p class="section-header__intro">{intro}</p>}
      {hasLinkSlot ? (
        <slot name="link" />
      ) : linkHref && (
        <a class="section-header__link" href={linkHref}>
          {linkLabel}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  )}
</header>

<style>
  .section-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
    align-items: end;
  }

  .section-header__kicker {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--surface-fg-muted, var(--color-text-muted));
  }

  .section-header__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    /* fluido 320→1240: ~2rem → ~3.5rem */
    font-size: clamp(2rem, 1.28rem + 3.6vw, 3.5rem);
    line-height: var(--line-tight);
    color: var(--surface-heading, var(--color-blue));
    max-inline-size: 16ch;
    text-wrap: balance;
  }

  .section-header__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-inline-size: 42ch;
  }

  .section-header__intro {
    margin: 0;
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: var(--surface-fg-muted, var(--color-text-muted));
  }

  .section-header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    align-self: start;
    min-block-size: 2.75rem; /* alvo de toque a11y */
    font-weight: var(--font-weight-semibold);
    color: var(--surface-fg, var(--color-blue));
    text-decoration: none;
  }

  .section-header__link svg {
    transition: transform var(--transition-duration-normal) var(--transition-easing-default);
  }

  @media (hover: hover) {
    .section-header__link:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    .section-header__link:hover svg {
      transform: translateX(0.2em);
    }
  }

  .section-header__link:focus-visible {
    outline: var(--border-width-strong) solid var(--surface-fg, var(--color-blue));
    outline-offset: var(--focus-outline-offset);
    border-radius: var(--radius-sm);
  }

  /* Assimetria a partir de ~48rem: título largo à esquerda, intro+link
     deslocados na coluna direita e alinhados embaixo (baseline editorial). */
  @media (min-width: 48rem) {
    .section-header {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .section-header__lead {
      grid-column: 1;
    }
    .section-header__aside {
      grid-column: 2;
      align-self: end;
      padding-block-end: var(--space-2xs);
    }
  }
</style>
