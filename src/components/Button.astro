---
/**
 * Button.astro — sistema de CTA presentacional.
 *
 * DISCIPLINA DO ÂMBAR (travada): só variant="book" pinta âmbar (ação de reserva).
 * Toda outra ação usa ghost/outline (azul/ink). Não há variante âmbar fora de "book".
 *
 * Reusa as classes .btn já tokenizadas em global.css — não redefine cor/estilo.
 *   book       -> .btn .btn-primary          (âmbar — reserva)
 *   ghost      -> .btn .btn-ghost-secondary  (texto azul, sem fundo)
 *   outline    -> .btn .btn-outline-secondary (contorno azul)
 *   solid-navy -> .btn .btn-solid-navy        (azul estrutural chapado — peso s/ âmbar)
 *
 * Polimórfico: href => <a>; senão <button>. Demais atributos (data-*, target,
 * rel, aria-*, type, id...) passam direto via ...rest. Ícone via <slot name="icon" />.
 */
const {
  variant = "outline",
  href,
  size,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const variantClass = {
  book: "btn-primary",
  ghost: "btn-ghost-secondary",
  outline: "btn-outline-secondary",
  "solid-navy": "btn-solid-navy",
}[variant] ?? "btn-outline-secondary";

const sizeClass = size === "sm" ? "btn-sm" : size === "lg" ? "btn-lg" : "";

const classes = ["btn", variantClass, sizeClass, "btn-cta", className]
  .filter(Boolean)
  .join(" ");

const Tag = href ? "a" : "button";
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot name="icon" />
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot name="icon" />
      <slot />
    </button>
  )
}

<style>
  /* Alvo de toque ≥44px (a11y/mobile) — sem redefinir cor/estilo do .btn. */
  .btn-cta {
    min-block-size: 2.75rem;
  }
  .btn-cta.btn-sm {
    min-block-size: 2.75rem;
  }


  /* variant="book" (âmbar de reserva): CHAPADO em repouso — EXATAMENTE o token de
     acento do tema (#D9742A light / #E8843C dark), sem gradient e SEM glow/bloom.
     `background:` (shorthand) zera o background-image do gradient herdado.
     Elevação/glow só em :hover e :focus-visible.
     Escopo: só botões renderizados por este Button (atributo de escopo do Astro)
     — não toca .btn-primary legado. Estilo do Astro não é @layer → vence o .btn de
     global.css, que está em @layer components. */
  .btn-primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: none;
  }
  @media (hover: hover) {
    .btn-primary:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      box-shadow: var(--shadow-accent-md);
    }
  }
  /* Foco: halo claro/escuro do anel global (--color-focus-halo) — garante ≥3:1
     mesmo com o botão âmbar (o glow âmbar não daria contraste sobre âmbar). */
  .btn-primary:focus-visible {
    box-shadow: 0 0 0 calc(var(--focus-outline-offset) + var(--focus-outline-width)) var(--color-focus-halo);
  }

  /* variant="solid-navy" (NÃO âmbar): azul estrutural CHAPADO + texto on-blue —
     peso sem gastar âmbar (mesmos tokens da banda da cunha; AA já provado lá).
     --color-blue é igual em light e dark, então o botão fica DISTINTO tanto no
     branco (light) quanto na surface escura (dark). Hover: um passo mais escuro +
     elevação suave (a base .btn já faz translateY e tem a transição). Escopo: só
     botões deste Button (atributo de escopo do Astro) → não toca .btn-* global. */
  .btn-solid-navy {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: var(--color-on-blue);
    box-shadow: none;
  }
  @media (hover: hover) {
    .btn-solid-navy:hover {
      background: color-mix(in srgb, var(--color-blue) 86%, black);
      border-color: color-mix(in srgb, var(--color-blue) 86%, black);
      color: var(--color-on-blue);
      box-shadow: 0 8px 22px color-mix(in srgb, var(--color-ink) 20%, transparent);
    }
  }
  .btn-solid-navy:focus-visible {
    box-shadow: 0 0 0 calc(var(--focus-outline-offset) + var(--focus-outline-width)) var(--color-focus-halo);
  }
  /* Dark: o fill (#2A4F91) fica perto da surface escura (~1.9:1) — borda bone sutil
     dá ≥3:1 de definição (non-text contrast), sem tocar o light (lá a borda = fill,
     invisível, e o fill já contrasta 8:1 com o branco). Cobre os dois casos de dark
     (atributo explícito + SO escuro sem atributo). */
  :global([data-theme="dark"]) .btn-solid-navy {
    border-color: color-mix(in srgb, var(--color-on-blue) 55%, transparent);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .btn-solid-navy {
      border-color: color-mix(in srgb, var(--color-on-blue) 55%, transparent);
    }
  }

  /* variant="outline" no DARK = tratamento BONE, idêntico ao hero. O default global
     usa navy (--color-primary) p/ texto+borda; sobre a base escura (#0E1A2B) isso dá
     ~1.9:1 (FAIL AA). Aqui, escopado a botões DESTE Button (cid) e SÓ no dark, texto
     e borda viram bone (--color-on-blue) → ~12:1, consistente com o WhatsApp do hero.
     Light intocado (navy sobre bone já passa). NÃO toca .btn-outline-secondary global
     nem <a> raw. Cobre data-theme="dark" + SO escuro sem atributo. */
  :global([data-theme="dark"]) .btn-outline-secondary {
    border-color: color-mix(in srgb, var(--color-on-blue) 55%, transparent);
    color: var(--color-on-blue);
  }
  @media (hover: hover) {
    :global([data-theme="dark"]) .btn-outline-secondary:hover {
      border-color: var(--color-on-blue);
      background-color: color-mix(in srgb, var(--color-on-blue) 12%, transparent);
      color: var(--color-on-blue);
    }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .btn-outline-secondary {
      border-color: color-mix(in srgb, var(--color-on-blue) 55%, transparent);
      color: var(--color-on-blue);
    }
  }
  @media (prefers-color-scheme: dark) and (hover: hover) {
    :global(:root:not([data-theme])) .btn-outline-secondary:hover {
      border-color: var(--color-on-blue);
      background-color: color-mix(in srgb, var(--color-on-blue) 12%, transparent);
      color: var(--color-on-blue);
    }
  }
</style>
