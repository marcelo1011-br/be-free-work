---
/**
 * HeroContained — B1b (primitivo do hero da home, linguagem do mockup).
 *
 * Hero CONTIDO (não full-bleed/overlay): banda azul estrutural #2A4F91 full-width,
 * CONSTANTE em light E dark (o hero é sempre "sobre azul" → texto bone, âmbar no
 * CTA primário, nos dois temas). Por isso usa só --color-blue/--color-on-blue
 * (tokens que não alternam por tema).
 *
 * Layout: container largo, 2 colunas — ESQ painel de conteúdo (navy um tom mais
 * fundo p/ leitura de "painel") com eyebrow → H1 → subhead → CTAs; DIR slot de
 * imagem (placeholder até a foto real do Rio). Filete vertical "EST. 2013 ·
 * CADASTUR" na borda direita.
 *
 * H1: Newsreader serif, bone, 2–3 linhas, com ênfase em UMA palavra em itálico.
 * É o ÚNICO <h1> da página (SectionHeaders são <h2>).
 *
 * DISCIPLINA DO ÂMBAR: o CTA primário (Button variant="book") é a ÚNICA instância
 * de âmbar do hero. Secundário = ghost/outline bone (não âmbar).
 *
 * Props (todas com placeholder; copy real entra no B2):
 *   eyebrow, title (slot p/ <em>), subhead, primaryLabel, primaryHref,
 *   secondaryLabel, secondaryHref, credential. Slot "image" sobrescreve o placeholder.
 */
import Button from "./Button.astro";

const {
  eyebrow = "Operadora local · privada",
  subhead = "Texto de apoio estrutural para validar três linhas de subtítulo sobre a banda azul, com peso leve e medida confortável de leitura ao lado do bloco de imagem.",
  primaryLabel = "Reservar passeio privado",
  primaryHref = "#",
  secondaryLabel = "Falar no WhatsApp",
  secondaryHref = "https://wa.me/5521979271637",
  credential = "EST. 2013 · CADASTUR",
  trust = [], // sinais de confiança fundidos no hero (4.9★ / 800+ / plataformas)
} = Astro.props;

const hasImageSlot = Astro.slots.has("image");
const hasTitleSlot = Astro.slots.has("default");
---

<section class="hero-contained">
  <div class="container hero-contained__grid">
    <div class="hero-contained__panel">
      <p class="hero-contained__eyebrow">{eyebrow}</p>

      <h1 class="hero-contained__title">
        {hasTitleSlot ? (
          <slot />
        ) : (
          <Fragment>Roteiros privados desenhados ao redor do <em>seu</em> tempo no Rio de Janeiro</Fragment>
        )}
      </h1>

      <p class="hero-contained__subhead">{subhead}</p>

      <div class="hero-contained__ctas">
        <Button variant="book" size="lg" href={primaryHref} class="hero-contained__cta-primary">
          {primaryLabel}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </Button>

        <Button variant="outline" size="lg" href={secondaryHref} class="hero-contained__cta-secondary" target="_blank" rel="noopener noreferrer">
          <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {secondaryLabel}
        </Button>
      </div>

      {trust.length > 0 && (
        <ul class="hero-contained__trust">
          {trust.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>

    <div class="hero-contained__media">
      {hasImageSlot ? (
        <slot name="image" />
      ) : (
        <div class="hero-contained__placeholder" role="img" aria-label="Espaço reservado para foto do Rio de Janeiro">
          <span>Foto do Rio · placeholder</span>
        </div>
      )}
    </div>
  </div>

  <span class="hero-contained__rule">{credential}</span>
</section>

<style>
  /* Banda azul constante nos dois temas (tokens que não alternam). */
  .hero-contained {
    position: relative;
    background-color: var(--color-blue);
    color: var(--color-on-blue);
    padding-block: var(--space-3xl);
    overflow: hidden;
  }

  .hero-contained__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    align-items: stretch;
  }

  /* Painel: navy um tom mais fundo p/ leitura de "contido" (constante nos temas). */
  .hero-contained__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: clamp(1.5rem, 1.1rem + 2vw, 2.75rem);
    background: color-mix(in srgb, var(--color-blue) 78%, black);
    border: var(--border-width-hairline) solid color-mix(in srgb, var(--color-on-blue) 14%, transparent);
    border-radius: var(--radius-lg);
  }

  .hero-contained__eyebrow {
    margin: 0;
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: color-mix(in srgb, var(--color-on-blue) 72%, transparent);
  }

  .hero-contained__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: clamp(2.25rem, 1.5rem + 3.75vw, 3.75rem);
    line-height: var(--line-tight);
    color: var(--color-on-blue);
    text-wrap: balance;
    max-inline-size: 18ch;
  }

  .hero-contained__title :global(em) {
    font-style: italic;
    font-weight: inherit;
  }

  .hero-contained__subhead {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-1);
    line-height: var(--line-snug);
    color: color-mix(in srgb, var(--color-on-blue) 82%, transparent);
    max-inline-size: 46ch;
  }

  .hero-contained__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xs);
  }

  /* Secundário: ghost/outline bone (NÃO âmbar) sobre a banda. */
  .hero-contained__ctas :global(.hero-contained__cta-secondary.btn-outline-secondary) {
    border-color: color-mix(in srgb, var(--color-on-blue) 55%, transparent);
    color: var(--color-on-blue);
    background-color: transparent;
  }
  @media (hover: hover) {
    .hero-contained__ctas :global(.hero-contained__cta-secondary.btn-outline-secondary:hover) {
      border-color: var(--color-on-blue);
      background-color: color-mix(in srgb, var(--color-on-blue) 12%, transparent);
      color: var(--color-on-blue);
    }
  }

  /* Slot de imagem / placeholder */
  .hero-contained__media {
    display: flex;
  }

  .hero-contained__placeholder {
    inline-size: 100%;
    min-block-size: clamp(14rem, 28vw, 24rem);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-on-blue) 8%, var(--color-blue));
    border: var(--border-width-hairline) dashed color-mix(in srgb, var(--color-on-blue) 28%, transparent);
    border-radius: var(--radius-lg);
    color: color-mix(in srgb, var(--color-on-blue) 60%, transparent);
    font-size: var(--text--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Filete vertical "EST. 2013 · CADASTUR" na borda direita. */
  .hero-contained__rule {
    position: absolute;
    right: var(--space-xs);
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-size: var(--text--1);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-on-blue) 52%, transparent);
    pointer-events: none;
  }

  /* Desktop: duas colunas (painel levemente maior). */
  @media (min-width: 56rem) {
    .hero-contained__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-xl);
    }
  }

  /* Mobile: empilha (painel acima, imagem abaixo); CTAs full-width; some o filete. */
  @media (max-width: 56rem) {
    .hero-contained__rule {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .hero-contained__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-contained__ctas :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
