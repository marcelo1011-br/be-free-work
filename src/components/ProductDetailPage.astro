---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import TourCard from "./TourCard.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import BookingForm from "./BookingForm.astro";
import { useTranslations } from "../i18n/utils";
import { aggregateRating } from "../data/siteData.js";

const {
  item,
  type,
  lang,
  allItems,
  heroImage,
  paymentPolicy,
  cancellationPolicy,
  seoData,
  pageSchemas,
  ogTags,
} = Astro.props;

const t = useTranslations(lang);

const routeMaps = {
  tour: {
    en: "private-tours",
    es: "tours-privados",
    "pt-br": "passeios-privados",
  },
  experience: {
    en: "experiences",
    es: "experiencias",
    "pt-br": "experiencias",
  },
};

const section = type === "experience" ? "experiences" : "tours";
const baseRoute = routeMaps[type]?.[lang] || routeMaps.tour.en;
const relatedItems = allItems
  .filter((candidate) => candidate.category === item.category && candidate.id !== item.id)
  .slice(0, 3);

// Conteúdo dinâmico — array vazio/ausente => a seção não renderiza (doc §8).
const highlights = item.highlights || [];
const included = item.included || [];
const notIncluded = item.notIncluded || [];
const tips = item.tips || [];
const faqs = item.faqs || [];
const recommendations = item.recommendations; // dado morto até aqui; publicado como "Best time to go" (doc §11 anexo)
const overviewParas = (item.fullDescription || "").split("\n\n").filter(Boolean);

const isCustomItem = item.isCustom || item.pricing?.custom;
const customPriceText = item.pricing?.displayText || "Custom quote";
const contactRoutes = {
  en: "contact",
  es: "contacto",
  "pt-br": "contato",
};
const contactRoute = contactRoutes[lang] || contactRoutes.en;
const alternateRoute = type === "experience" ? routeMaps.tour[lang] : routeMaps.experience[lang];
const overviewTitle = type === "experience" ? t("product.aboutExperience") : t("product.aboutTour");
const overviewIntro = type === "experience" ? t("product.overviewIntroExperience") : t("product.overviewIntroTour");
const alternateLabel = type === "experience" ? t("product.altLineExperienceLabel") : t("product.altLineTourLabel");
const alternateButton = type === "experience" ? t("product.altLineExperienceButton") : t("product.altLineTourButton");

// getFromPrice — trata os quatro formatos (doc §9). NÃO reimplementar.
function getFromPrice(pricing = {}) {
  if (pricing.custom) return null;
  if (pricing.from) return pricing.from;
  if (pricing.perPerson) return pricing.perPerson;
  if (pricing.standard) {
    const prices = Object.values(pricing.standard);
    return Math.min(...prices);
  }
  return null;
}

const pricing = item.pricing || {};
const fromPrice = getFromPrice(pricing);

// priceMode: "group" (A) · "boat" (B) · "perPerson" (D) · "custom" (C) (doc §9)
let priceMode = "custom";
let groupOptions = []; // formato A: [{ size, price }]
let boatGroups = null; // formato B: [{ name, ranges:[{range,price}] }]
let perPersonPrice = null; // formato D

if (pricing.custom) {
  priceMode = "custom";
} else if (pricing.priceTable) {
  priceMode = "group";
  groupOptions = Object.keys(pricing.priceTable)
    .map(Number)
    .filter((n) => !Number.isNaN(n))
    .sort((a, b) => a - b)
    .map((n) => ({ size: n, price: pricing.priceTable[String(n)] }));
} else if (pricing.standard) {
  priceMode = "boat";
  boatGroups = [
    {
      key: "standard",
      name: t("product.standardPackage"),
      ranges: Object.entries(pricing.standard).map(([range, price]) => ({ range, price })),
    },
    ...(pricing.lopesMendes
      ? [
          {
            key: "lopesMendes",
            name: `${t("product.premiumPackage")} ${t("product.lopesMendesPackage")}`,
            ranges: Object.entries(pricing.lopesMendes).map(([range, price]) => ({ range, price })),
          },
        ]
      : []),
  ];
} else if (pricing.perPerson) {
  priceMode = "perPerson";
  perPersonPrice = pricing.perPerson;
}

const hasAmberBooking = priceMode !== "custom"; // formato C: zero âmbar (doc §10)

const waMessages = {
  en: `Hi, I have a question about the ${item.title} tour.`,
  es: `Hola, tengo una pregunta sobre el tour ${item.title}.`,
  "pt-br": `Olá, tenho uma dúvida sobre o passeio ${item.title}.`,
};
const waLink = `https://wa.me/5521979271637?text=${encodeURIComponent(waMessages[lang] || waMessages.en)}`;

const breadcrumbItems = [
  { name: "Home", url: `/${lang}` },
  {
    name: type === "experience" ? t("nav.experiences") : t("nav.privateTours"),
    url: `/${lang}/${baseRoute}`,
  },
  { name: item.title, url: `/${lang}/${baseRoute}/${item.slug}` },
];

// Rótulos novos que o doc introduz e que NÃO existem no i18n (proibido tocar i18n/**).
// Inline por locale, no molde do copyByType original.
const L = {
  en: {
    eyebrowOverview: "Overview",
    eyebrowItinerary: "The day",
    itineraryTitle: "What you'll see",
    eyebrowIncluded: "The details",
    eyebrowTiming: "Timing",
    bestTimeTitle: "Best time to go",
    eyebrowProof: "Proof",
    proofTitle: "People who were there",
    proofCaption: "Real client photos — the tour, not a postcard.",
    proofEmpty: "Client photos for this tour are being indexed.",
    eyebrowVoices: "Voices",
    voicesTitle: "Travellers say",
    voicesEmpty: "Per-tour reviews are being connected.",
    eyebrowFaq: "Questions",
    eyebrowRelated: "Keep exploring",
    eyebrowBooking: "Reserve",
    bookingTitle: "Reserve your day",
    readMore: "Read the full description",
    readLess: "Show less",
    swipe: "Swipe →",
    reserve: type === "experience" ? "Reserve this experience" : "Reserve this tour",
    heroBook: "Book this tour",
    payNote: "Pay nothing until 72h before",
    groupNote: "Group total — not per person",
    perPersonNote: "per person",
    requestQuote: "Request a custom quote",
    cardTrust: "72h free cancellation · Cadastur licensed · Since 2013",
    trust: {
      reviews: "verified reviews",
      tripadvisor: "TripAdvisor",
      licensed: "Cadastur licensed",
      since: "Since 2013",
      travellers: "~15,000 travellers",
    },
    whatsapp: "Questions? WhatsApp us",
    viewAll: type === "experience" ? "View all experiences" : "View all tours",
  },
  es: {
    eyebrowOverview: "Resumen",
    eyebrowItinerary: "El día",
    itineraryTitle: "Lo que verás",
    eyebrowIncluded: "Los detalles",
    eyebrowTiming: "Cuándo",
    bestTimeTitle: "Mejor momento para ir",
    eyebrowProof: "Prueba",
    proofTitle: "Quienes estuvieron allí",
    proofCaption: "Fotos reales de clientes — el tour, no una postal.",
    proofEmpty: "Las fotos de clientes de este tour se están indexando.",
    eyebrowVoices: "Voces",
    voicesTitle: "Lo que dicen los viajeros",
    voicesEmpty: "Las reseñas por tour se están conectando.",
    eyebrowFaq: "Preguntas",
    eyebrowRelated: "Seguí explorando",
    eyebrowBooking: "Reservar",
    bookingTitle: "Reserva tu día",
    readMore: "Leer la descripción completa",
    readLess: "Mostrar menos",
    swipe: "Deslizá →",
    reserve: type === "experience" ? "Reservar esta experiencia" : "Reservar este tour",
    heroBook: "Reservar este tour",
    payNote: "Sin pagar hasta 72h antes",
    groupNote: "Total del grupo — no por persona",
    perPersonNote: "por persona",
    requestQuote: "Solicitar presupuesto",
    cardTrust: "Cancelación gratis 72h · Licencia Cadastur · Desde 2013",
    trust: {
      reviews: "reseñas verificadas",
      tripadvisor: "TripAdvisor",
      licensed: "Licencia Cadastur",
      since: "Desde 2013",
      travellers: "~15.000 viajeros",
    },
    whatsapp: "¿Dudas? Escríbenos por WhatsApp",
    viewAll: type === "experience" ? "Ver todas las experiencias" : "Ver todos los tours",
  },
  "pt-br": {
    eyebrowOverview: "Resumo",
    eyebrowItinerary: "O dia",
    itineraryTitle: "O que você vai ver",
    eyebrowIncluded: "Os detalhes",
    eyebrowTiming: "Quando",
    bestTimeTitle: "Melhor hora para ir",
    eyebrowProof: "Prova",
    proofTitle: "Quem esteve lá",
    proofCaption: "Fotos reais de clientes — o passeio, não um cartão-postal.",
    proofEmpty: "As fotos de clientes deste passeio estão sendo indexadas.",
    eyebrowVoices: "Vozes",
    voicesTitle: "O que dizem os viajantes",
    voicesEmpty: "As avaliações por passeio estão sendo conectadas.",
    eyebrowFaq: "Perguntas",
    eyebrowRelated: "Continue explorando",
    eyebrowBooking: "Reservar",
    bookingTitle: "Reserve seu dia",
    readMore: "Ler a descrição completa",
    readLess: "Mostrar menos",
    swipe: "Arraste →",
    reserve: type === "experience" ? "Reservar esta experiência" : "Reservar este passeio",
    heroBook: "Reservar este passeio",
    payNote: "Pague só 72h antes",
    groupNote: "Total do grupo — não por pessoa",
    perPersonNote: "por pessoa",
    requestQuote: "Solicitar orçamento",
    cardTrust: "Cancelamento grátis 72h · Licença Cadastur · Desde 2013",
    trust: {
      reviews: "avaliações verificadas",
      tripadvisor: "TripAdvisor",
      licensed: "Licença Cadastur",
      since: "Desde 2013",
      travellers: "~15.000 viajantes",
    },
    whatsapp: "Dúvidas? Fale pelo WhatsApp",
    viewAll: type === "experience" ? "Ver todas as experiências" : "Ver todos os passeios",
  },
};
const c = L[lang] || L.en;

// TODO: DADO REAL PENDENTE — não existe manifest arquivo->atração para src/images/gallery/.
// Estas duas seções renderizam placeholder. NÃO SUBIR PARA PRODUÇÃO ASSIM.
const proofPhotos = []; // [{ src, caption }] — ligar quando o manifest existir
const travellerReviews = []; // [{ quote, author, rating }] — não existe review por tour em tours.js
const heroAlt = highlights[0]
  ? `${item.title} - ${t("product.heroImageAlt")} ${highlights[0]}`
  : item.title;
---

<BaseLayout
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  type="product"
  schema={pageSchemas}
  ogTags={ogTags}
>
  <Breadcrumbs items={breadcrumbItems} />

  {/* 3 · HERO — gradiente navy sob foto full-bleed (doc §2, §12) */}
  <section class="pdp-hero">
    <div class="pdp-hero__media">
      <Image
        src={heroImage}
        alt={heroAlt}
        width={1920}
        height={1080}
        format="webp"
        quality={85}
        loading="eager"
      />
      <div class="pdp-hero__scrim"></div>
    </div>
    <div class="container pdp-hero__inner">
      <h1 class="pdp-hero__title">{item.title}</h1>
      <div class="pdp-hero__meta">
        {item.duration && <span class="pdp-hero__chip">{item.duration}</span>}
        <span class="pdp-hero__chip pdp-hero__chip--rating">
          ★ {aggregateRating.ratingValue} · {aggregateRating.reviewCount}+
        </span>
      </div>

      <div class="pdp-hero__price">
        {priceMode === "custom" ? (
          <span class="pdp-hero__price-custom">{customPriceText}</span>
        ) : priceMode === "perPerson" ? (
          <>
            <span class="pdp-hero__price-from">{t("product.from")}</span>
            <span class="pdp-hero__price-value">US$ {perPersonPrice}</span>
            <span class="pdp-hero__price-unit">{c.perPersonNote}</span>
          </>
        ) : (
          <>
            <span class="pdp-hero__price-from">{t("product.from")}</span>
            <span class="pdp-hero__price-value">US$ {fromPrice}</span>
            <span class="pdp-hero__price-unit">{c.groupNote}</span>
          </>
        )}
      </div>

      <div class="pdp-hero__actions">
        {hasAmberBooking ? (
          <button type="button" class="pdp-btn pdp-btn--amber pdp-btn--lg" data-booking-trigger>
            {c.heroBook}
          </button>
        ) : (
          <a href={`/${lang}/${contactRoute}`} class="pdp-btn pdp-btn--outline-dark pdp-btn--lg">
            {c.requestQuote}
          </a>
        )}
        <a href={waLink} class="pdp-hero__wa" target="_blank" rel="noopener noreferrer">
          {c.whatsapp}
        </a>
      </div>
    </div>
  </section>

  {/* 4 · TRUST BAR — faixa branca, separa hero do corpo (doc §2) */}
  <section class="pdp-trust">
    <div class="container pdp-trust__inner">
      <span class="pdp-trust__item pdp-trust__item--star">
        ★ {aggregateRating.ratingValue} · {aggregateRating.reviewCount}+ {c.trust.reviews}
      </span>
      <span class="pdp-trust__sep" aria-hidden="true"></span>
      <span class="pdp-trust__item">{c.trust.tripadvisor}</span>
      <span class="pdp-trust__sep" aria-hidden="true"></span>
      <span class="pdp-trust__item">{c.trust.licensed}</span>
      <span class="pdp-trust__sep" aria-hidden="true"></span>
      <span class="pdp-trust__item">{c.trust.since}</span>
      <span class="pdp-trust__sep" aria-hidden="true"></span>
      <span class="pdp-trust__item">{c.trust.travellers}</span>
    </div>
  </section>

  {/* 5 · CORPO — grid conteúdo + booking card sticky (doc §2, §6) */}
  <section class="pdp-body">
    <div class="container pdp-body__grid">
      <div class="pdp-body__main">
        {/* Overview + read-more (doc §11) */}
        <div class="pdp-block">
          <header class="pdp-head">
            <span class="pdp-eyebrow">{c.eyebrowOverview}</span>
            <h2 class="pdp-h2">{overviewTitle}</h2>
          </header>
          <p class="pdp-lead">{overviewIntro}</p>
          {overviewParas.length > 0 && (
            <div class="pdp-overview" data-readmore>
              <p class="pdp-prose pdp-prose--first">{overviewParas[0]}</p>
              {overviewParas.length > 1 && (
                <div class="pdp-overview__more" id="pdp-overview-more" data-readmore-body>
                  {overviewParas.slice(1).map((paragraph) => (
                    <p class="pdp-prose">{paragraph}</p>
                  ))}
                </div>
              )}
              {overviewParas.length > 1 && (
                <button
                  type="button"
                  class="pdp-readmore"
                  data-readmore-toggle
                  aria-expanded="false"
                  aria-controls="pdp-overview-more"
                  data-label-more={c.readMore}
                  data-label-less={c.readLess}
                >
                  {c.readMore}
                </button>
              )}
            </div>
          )}
          <div class="pdp-crosslink">
            <p class="pdp-crosslink__text">{alternateLabel}</p>
            <a href={`/${lang}/${alternateRoute}`} class="pdp-btn pdp-btn--outline pdp-btn--md">
              {alternateButton}
            </a>
          </div>
        </div>

        {/* Itinerário — highlights expostas e numeradas (doc §8) */}
        {highlights.length > 0 && (
          <div class="pdp-block">
            <header class="pdp-head">
              <span class="pdp-eyebrow">{c.eyebrowItinerary}</span>
              <h2 class="pdp-h2">{c.itineraryTitle}</h2>
            </header>
            <ol class={`pdp-num-list ${highlights.length >= 4 ? "is-multi" : ""}`}>
              {highlights.map((highlight, i) => (
                <li class="pdp-num">
                  <span class="pdp-num__n">{String(i + 1).padStart(2, "0")}</span>
                  <span class="pdp-num__label">{highlight}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        {/* What's included + Not included (doc §8) */}
        {included.length > 0 && (
          <div class="pdp-block">
            <header class="pdp-head">
              <span class="pdp-eyebrow">{c.eyebrowIncluded}</span>
              <h2 class="pdp-h2">{t("product.whatsIncluded")}</h2>
            </header>
            <div class="pdp-incl">
              <ul class={`pdp-incl-list ${included.length >= 4 ? "is-multi" : ""}`}>
                {included.map((includedItem) => (
                  <li class="pdp-incl__row pdp-incl__row--yes">
                    <span class="pdp-incl__mark" aria-hidden="true">✓</span>
                    <span>{includedItem}</span>
                  </li>
                ))}
              </ul>
              {notIncluded.length > 0 && (
                <div class="pdp-panel pdp-notincl">
                  <p class="pdp-notincl__title">{t("product.notIncluded")}</p>
                  <ul class="pdp-incl-list">
                    {notIncluded.map((excludedItem) => (
                      <li class="pdp-incl__row pdp-incl__row--no">
                        <span class="pdp-incl__mark" aria-hidden="true">—</span>
                        <span>{excludedItem}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        )}

        {/* Best time to go — publica item.recommendations (doc §11 anexo). Ausente => não renderiza. */}
        {recommendations && (
          <div class="pdp-block">
            <header class="pdp-head">
              <span class="pdp-eyebrow">{c.eyebrowTiming}</span>
              <h2 class="pdp-h2">{c.bestTimeTitle}</h2>
            </header>
            <p class="pdp-prose pdp-prose--contained">{recommendations}</p>
          </div>
        )}

        {/* Good to know — tips expostas e numeradas (doc §8) */}
        {tips.length > 0 && (
          <div class="pdp-block">
            <header class="pdp-head">
              <span class="pdp-eyebrow">{c.eyebrowIncluded}</span>
              <h2 class="pdp-h2">{t("product.goodToKnow")}</h2>
            </header>
            <ol class={`pdp-num-list ${tips.length >= 4 ? "is-multi" : ""}`}>
              {tips.map((tip, i) => (
                <li class="pdp-num">
                  <span class="pdp-num__n">{String(i + 1).padStart(2, "0")}</span>
                  <span class="pdp-num__label">{tip}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      {/* Booking card — sticky no desktop, seção normal no mobile (doc §6) */}
      <aside class="pdp-book" data-pricing={JSON.stringify(pricing)}>
        <header class="pdp-head pdp-book__head">
          <span class="pdp-eyebrow">{c.eyebrowBooking}</span>
          <h2 class="pdp-h3">{c.bookingTitle}</h2>
        </header>

        {priceMode === "custom" ? (
          <div class="pdp-book__body">
            <p class="pdp-book__custom">{customPriceText}</p>
            <p class="pdp-book__note">{t("product.customPriceDescription")}</p>
            <a href={`/${lang}/${contactRoute}`} class="pdp-btn pdp-btn--outline pdp-btn--lg pdp-book__cta">
              {c.requestQuote}
            </a>
          </div>
        ) : (
          <div class="pdp-book__body">
            <div class="pdp-book__price">
              <span class="pdp-book__cur">US$</span>
              <span class="pdp-book__amount" data-price-amount>
                {priceMode === "perPerson" ? perPersonPrice : fromPrice}
              </span>
              <span class="pdp-book__unit">
                {priceMode === "perPerson" ? c.perPersonNote : c.groupNote}
              </span>
            </div>

            {priceMode === "group" && (
              <div class="pdp-book__chips" role="group" aria-label={t("product.groupSize")}>
                {groupOptions.map((opt, i) => (
                  <button
                    type="button"
                    class="pdp-chip"
                    data-price={opt.price}
                    aria-pressed={i === 0 ? "true" : "false"}
                  >
                    {opt.size} {t("product.people")}
                  </button>
                ))}
              </div>
            )}

            {priceMode === "boat" && boatGroups && (
              <div class="pdp-book__boats">
                {boatGroups.map((boat) => (
                  <div class="pdp-boat">
                    <p class="pdp-boat__name">{boat.name}</p>
                    <div class="pdp-book__chips" role="group" aria-label={boat.name}>
                      {boat.ranges.map((r) => (
                        <button type="button" class="pdp-chip" data-price={r.price}>
                          {r.range} {t("product.people")}
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}

            <button type="button" class="pdp-btn pdp-btn--amber pdp-btn--lg pdp-book__cta" data-booking-trigger>
              {c.reserve}
            </button>
            <p class="pdp-book__pay">{c.payNote}</p>
            <p class="pdp-book__trust">{c.cardTrust}</p>
          </div>
        )}
      </aside>
    </div>
  </section>

  {/* 6 · PROVA — fotos de cliente (doc §12). PLACEHOLDER. */}
  {/* TODO: DADO REAL PENDENTE — não existe manifest arquivo->atração para src/images/gallery/.
      Seção renderiza placeholder. NÃO SUBIR PARA PRODUÇÃO ASSIM. */}
  <section class="pdp-proof">
    <div class="container">
      <header class="pdp-head">
        <span class="pdp-eyebrow">{c.eyebrowProof}</span>
        <h2 class="pdp-h2">{c.proofTitle}</h2>
      </header>
      <p class="pdp-proof__caption">{c.proofCaption}</p>
      {proofPhotos.length > 0 ? (
        <ul class="pdp-proof__rail">
          {proofPhotos.map((photo) => (
            <li class="pdp-proof__item">
              <figure class="pdp-proof__fig">
                <img src={photo.src} alt="" loading="lazy" />
                <figcaption>{photo.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      ) : (
        <div class="pdp-placeholder" data-placeholder="proof">{c.proofEmpty}</div>
      )}
    </div>
  </section>

  {/* 7 · DEPOIMENTOS — reviews por tour (doc §2). PLACEHOLDER. */}
  {/* TODO: DADO REAL PENDENTE — não existe review por tour em tours.js; testimonials.js é business-wide.
      Seção renderiza placeholder. NÃO SUBIR PARA PRODUÇÃO ASSIM. */}
  <section class="pdp-voices">
    <div class="container">
      <header class="pdp-head">
        <span class="pdp-eyebrow">{c.eyebrowVoices}</span>
        <h2 class="pdp-h2">{c.voicesTitle}</h2>
      </header>
      {travellerReviews.length > 0 ? (
        <ul class="pdp-voices__grid">
          {travellerReviews.map((review) => (
            <li class="pdp-panel pdp-voice">
              <p class="pdp-voice__quote">{review.quote}</p>
              <p class="pdp-voice__author">{review.author}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="pdp-placeholder" data-placeholder="voices">{c.voicesEmpty}</div>
      )}
    </div>
  </section>

  {/* 8 · FAQ + POLICIES — dois acordeões, todos fechados (doc §13) */}
  {(faqs.length > 0 || paymentPolicy || cancellationPolicy) && (
    <section class="pdp-faq">
      <div class="container pdp-faq__grid">
        {faqs.length > 0 && (
          <div class="pdp-block">
            <header class="pdp-head">
              <span class="pdp-eyebrow">{c.eyebrowFaq}</span>
              <h2 class="pdp-h2">{t("product.faqs")}</h2>
            </header>
            <div class="pdp-acc">
              {faqs.map((faq, i) => (
                <div class="pdp-acc__item">
                  <button
                    type="button"
                    class="pdp-acc__header"
                    data-acc-trigger
                    aria-expanded="false"
                    aria-controls={`pdp-faq-${i}`}
                  >
                    <span>{faq.q}</span>
                    <span class="pdp-acc__icon" aria-hidden="true">+</span>
                  </button>
                  <div class="pdp-acc__panel" id={`pdp-faq-${i}`} role="region" hidden>
                    <p>{faq.a}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="pdp-block">
          <header class="pdp-head">
            <span class="pdp-eyebrow">{c.eyebrowFaq}</span>
            <h2 class="pdp-h2">{t("product.pricingPayment")}</h2>
          </header>
          <div class="pdp-acc">
            {paymentPolicy && (
              <div class="pdp-acc__item">
                <button
                  type="button"
                  class="pdp-acc__header"
                  data-acc-trigger
                  aria-expanded="false"
                  aria-controls="pdp-pol-pay"
                >
                  <span>{paymentPolicy.title}</span>
                  <span class="pdp-acc__icon" aria-hidden="true">+</span>
                </button>
                <div class="pdp-acc__panel" id="pdp-pol-pay" role="region" hidden>
                  <ul class="pdp-policy">
                    {paymentPolicy.items.map((policyItem) => (
                      <li><strong>{policyItem.label}</strong>{policyItem.text}</li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
            {cancellationPolicy && (
              <div class="pdp-acc__item">
                <button
                  type="button"
                  class="pdp-acc__header"
                  data-acc-trigger
                  aria-expanded="false"
                  aria-controls="pdp-pol-cancel"
                >
                  <span>{cancellationPolicy.title}</span>
                  <span class="pdp-acc__icon" aria-hidden="true">+</span>
                </button>
                <div class="pdp-acc__panel" id="pdp-pol-cancel" role="region" hidden>
                  <ul class="pdp-policy">
                    {cancellationPolicy.items.map((policyItem) => (
                      <li><strong>{policyItem.label}</strong>{policyItem.text}</li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* 9 · RELATED — TourCard 3-up (doc §2, §6) */}
  {relatedItems.length > 0 && (
    <section class="pdp-related">
      <div class="container">
        <header class="pdp-head">
          <span class="pdp-eyebrow">{c.eyebrowRelated}</span>
          <h2 class="pdp-h2">{t("product.relatedItems")}</h2>
        </header>
        <div class="pdp-related__grid">
          {relatedItems.map((relatedItem) => (
            <TourCard item={relatedItem} lang={lang} section={section} />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* 10 · BOOKING FORM — banda navy (doc §2) */}
  <BookingForm tour={item} lang={lang} />

  {/* 11 · CTA FINAL — banda azul, outline (doc §2, §10) */}
  <section class="pdp-final">
    <div class="container pdp-final__inner">
      <h2 class="pdp-final__title">{t("product.readyToBook")}</h2>
      <p class="pdp-final__sub">{t("product.readyToBookSubtitle")}</p>
      <div class="pdp-final__actions">
        {hasAmberBooking ? (
          <button type="button" class="pdp-btn pdp-btn--outline-dark pdp-btn--lg" data-booking-trigger>
            {c.reserve}
          </button>
        ) : (
          <a href={`/${lang}/${contactRoute}`} class="pdp-btn pdp-btn--outline-dark pdp-btn--lg">
            {c.requestQuote}
          </a>
        )}
        <a href={`/${lang}/${baseRoute}`} class="pdp-final__ghost">{c.viewAll}</a>
      </div>
    </div>
  </section>
</BaseLayout>

