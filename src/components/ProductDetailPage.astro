<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Read-more (doc §11): texto sempre no DOM; botão aria-expanded
    document.querySelectorAll("[data-readmore-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const wrap = btn.closest("[data-readmore]");
        const body = wrap?.querySelector("[data-readmore-body]");
        if (!body) return;
        const open = body.classList.toggle("is-open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        btn.textContent = open ? btn.dataset.labelLess : btn.dataset.labelMore;
      });
    });

    // Acordeão FAQ + policies (doc §13): todos fechados por default
    document.querySelectorAll("[data-acc-trigger]").forEach((header) => {
      header.addEventListener("click", () => {
        const expanded = header.getAttribute("aria-expanded") === "true";
        const panelId = header.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        header.setAttribute("aria-expanded", expanded ? "false" : "true");
        if (panel) panel.hidden = expanded;
      });
    });

    // Booking card: preço ao vivo por chip (formato A e B)
    document.querySelectorAll(".pdp-book").forEach((card) => {
      const amount = card.querySelector("[data-price-amount]");
      const chips = card.querySelectorAll(".pdp-chip");
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          if (amount && chip.dataset.price) amount.textContent = chip.dataset.price;
          // aria-pressed exclusivo dentro do mesmo grupo
          const grp = chip.closest(".pdp-book__chips");
          grp?.querySelectorAll(".pdp-chip").forEach((c) => c.setAttribute("aria-pressed", "false"));
          chip.setAttribute("aria-pressed", "true");
        });
      });
    });
  });
</script>
