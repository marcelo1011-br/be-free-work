---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DayTripsPillar from "../../components/DayTripsPillar.astro";
import { dayTripsProse } from "../../data/dayTripsContent.js";

const lang = "es";
const t = dayTripsProse[lang];

const breadcrumbItems = [
  { name: "Inicio", url: `/${lang}` },
  { name: t.hero.title, url: `/${lang}/excursiones-desde-rio-de-janeiro` },
];
---

<BaseLayout title={t.seo.title} description={t.seo.description}>
  <Breadcrumbs items={breadcrumbItems} />
  <DayTripsPillar lang={lang} />
</BaseLayout>
