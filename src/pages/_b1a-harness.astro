---
/**
 * HARNESS TEMPORÁRIA — B1a (NÃO é página de produção).
 * Prefixo "_" → Astro exclui do build e do sitemap (produção segue 107 páginas).
 * Existe só para revisar/screenshotar os primitivos isolados (surface + SectionHeader);
 * o wire na home real é o B2. Preview via `astro dev` em /_b1a-harness/.
 *
 * Layout mínimo proposital (sem BaseLayout/nav/footer/schema) p/ isolar os primitivos.
 */
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/surfaces.css";
import SectionHeader from "../components/SectionHeader.astro";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>B1a harness — surfaces + SectionHeader</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/plus-jakarta-sans.css" />
  </head>
  <body>
    <!-- Superfície 1: bone quente -->
    <section class="surface surface-bone">
      <div class="container">
        <SectionHeader
          kicker="Por que a Be Free"
          title="O Rio como só quem é daqui mostra"
          intro="Guias cariocas certificados, roteiro flexível e tudo incluído — do Cristo ao pôr do sol no Pão de Açúcar, sem fila onde dá e sem letra miúda."
          linkHref="#"
          linkLabel="Ver todos os passeios"
        />
      </div>
    </section>

    <!-- Superfície 2: banda azul -->
    <section class="surface surface-blue">
      <div class="container">
        <SectionHeader
          kicker="Experiências locais"
          title="Histórias que não cabem num guia de viagem"
          intro="Caminhadas, sabores e bairros pela mão de quem mora aqui — no seu ritmo, em inglês, espanhol ou português."
          linkHref="#"
          linkLabel="Ver experiências"
        />
      </div>
    </section>

    <!-- Variante sem link (só título + intro) sobre bone, p/ checar o grid assimétrico -->
    <section class="surface surface-bone">
      <div class="container">
        <SectionHeader
          title="Reserve agora, pague só 72h antes"
          intro="Sem pagamento adiantado e cancelamento grátis até 72 horas antes do passeio."
        />
      </div>
    </section>
  </body>
</html>
