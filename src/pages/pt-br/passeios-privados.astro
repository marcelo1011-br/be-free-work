---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tours } from "../../data/tours.js";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductListing from "../../components/ProductListing.astro";
import { getPageSEO, getProductsCollectionSchema, getBreadcrumbSchema } from "../../utils/seoHelpers.js";

const lang = "pt-br";
const items = tours[lang];
const contactRoute = "contato";
const altRoute = "experiencias";

const siteUrl = (Astro.site?.toString() || "https://befreetours.com.br").replace(/\/$/, "");
const seo = getPageSEO("privateTours", lang);
const collectionSchema = getProductsCollectionSchema(items, lang, siteUrl);

const breadcrumbItems = [
  { name: "Home", url: `/${lang}` },
  { name: "Passeios Privados", url: `/${lang}/passeios-privados` },
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems, siteUrl);

const schemas = [collectionSchema, breadcrumbSchema];

---

<BaseLayout title={seo.title} description={seo.description} schema={schemas}>
  <Breadcrumbs items={breadcrumbItems} />

  <ProductListing
    lang={lang}
    items={items}
    section="tours"
    i18nPrefix="toursHub"
    filters={[
      { value: "all", labelKey: "filterAll" },
      { value: "city-tours", labelKey: "filterCity" },
      { value: "day-trips", labelKey: "filterDay" },
    ]}
    contactRoute={contactRoute}
    altRoute={altRoute}
  />
</BaseLayout>
