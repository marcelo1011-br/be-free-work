---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experiences } from "../../data/experiences.js";
import { useTranslations } from "../../i18n/utils";
import TourCard from "../../components/TourCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroPages from "../../components/HeroPages.astro";
import ExperiencesHubSections from "../../components/ExperiencesHubSections.astro";
import { experiencesHubContent } from "../../data/experiencesHubContent.js";
import { getPageSEO, getProductsCollectionSchema, getBreadcrumbSchema, getFAQSchema } from "../../utils/seoHelpers.js";

const lang = "pt-br";
const t = useTranslations(lang);
const items = experiences[lang];
const siteUrl = (Astro.site?.toString() || "https://befreetours.com.br").replace(/\/$/, "");
const seo = getPageSEO("experiences", lang);
const collectionSchema = getProductsCollectionSchema(items, lang, siteUrl, "experiences");
const faqSchema = getFAQSchema(experiencesHubContent[lang].faq.items);
const contactRoute = "contato";
const altRoute = "passeios-privados";
const breadcrumbItems = [
  { name: "Home", url: `/${lang}` },
  { name: "Experiências", url: `/${lang}/experiencias` },
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems, siteUrl);
const schemas = [collectionSchema, faqSchema, breadcrumbSchema].filter(Boolean);
---

<BaseLayout title={seo.title} description={seo.description} schema={schemas}>
  <Breadcrumbs items={breadcrumbItems} />

  <HeroPages
    title={t("experiencesHub.title")}
    subtitle={t("experiencesHub.subtitle")}
    maxWidth="clamp(40rem, 75vw, 50rem)"
  />

  <ExperiencesHubSections lang={lang} />

  <section id="experiences-list" class="products-grid-section">
    <div class="container">
      <div class="product-grid grid grid-4">
        {
          items.map((item) => (
            <div class="product-item" data-category={item.category}>
              <TourCard item={item} lang={lang} section="experiences" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ExperiencesHubSections lang={lang} showFaqOnly={true} />

  <section class="products-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">{t("experiencesHub.ctaTitle")}</h2>
        <p class="cta-subtitle">{t("experiencesHub.ctaSubtitle")}</p>
        <a href={`/${lang}/${contactRoute}`} class="btn btn-primary btn-lg">
          {t("experiencesHub.ctaButton")}
        </a>
        <p class="cta-secondary-text">{t("experiencesHub.altLinkLabel")}</p>
        <a href={`/${lang}/${altRoute}`} class="btn btn-outline-secondary btn-lg">
          {t("experiencesHub.altLinkButton")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .products-hero {
    --products-hero-offset: clamp(2rem, 6vw, 2.5rem);
    --products-hero-offset-mobile: clamp(2.5rem, 8vw, 3.75rem);
    --products-hero-subtitle-max: clamp(40rem, 75vw, 50rem);

    padding: calc(var(--space-3xl) + var(--products-hero-offset)) 0 var(--space-3xl);
    background: linear-gradient(135deg, var(--color-bg-dark) 0%, var(--color-primary) 50%, var(--color-bg-dark) 100%);
    text-align: center;
  }

  .hero-title {
    color: var(--color-text-inverse);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--font-size-h5);
    color: color-mix(in srgb, var(--color-text-inverse) 90%, transparent);
    max-width: var(--products-hero-subtitle-max);
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .products-grid-section {
    --products-grid-offset: clamp(2rem, 6vw, 2.5rem);
    padding: calc(var(--space-3xl) + var(--products-grid-offset)) 0 var(--space-3xl);
  }

  .products-grid-section .container {
    max-width: none;
    padding-inline: var(--space-xl-compact);
  }

  .product-grid {
    margin-bottom: var(--space-2xl);
    gap: var(--space-md);
  }

  @media (min-width: 1200px) {
    .product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .product-item {
    transition: opacity var(--transition-duration-slow) var(--transition-easing-default), transform var(--transition-duration-slow) var(--transition-easing-default);
  }

  .cta-secondary-text {
    margin: var(--space-lg) 0 var(--space-sm);
    color: var(--color-text-inverse);
  }

  .products-cta {
    padding: var(--space-3xl) 0;
    background: linear-gradient(135deg, var(--color-bg-dark) 0%, var(--color-primary) 50%, var(--color-bg-dark) 100%);
  }

  .cta-content {
    text-align: center;
    max-width: clamp(40rem, 75vw, 50rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .cta-title {
    color: var(--color-text-inverse);
    margin: 0;
  }

  .cta-subtitle {
    font-size: var(--font-size-h5);
    color: color-mix(in srgb, var(--color-text-inverse) 90%, transparent);
    margin: 0;
  }

  @media (max-width: 768px) {
    .products-hero {
      padding: calc(var(--space-3xl) + var(--products-hero-offset-mobile)) 0 var(--space-xl);
    }

    .hero-title {
      font-size: var(--font-size-h3);
    }

    .hero-subtitle {
      font-size: var(--font-size-body);
    }

    .products-grid-section {
      padding: var(--space-2xl) 0;
    }

    .tours-cta {
      padding: var(--space-2xl) 0;
    }
  }
</style>
