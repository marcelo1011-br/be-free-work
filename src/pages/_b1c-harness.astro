---
/**
 * HARNESS TEMPORÁRIA — B1c (NÃO é página de produção).
 * Prefixo "_" → fora do build/sitemap. Preview via `astro dev` (cópia temporária).
 * Cards sobre seção var(--color-base) p/ ver surface-on-base. Conteúdo placeholder.
 */
import "../styles/tokens.css";
import "../styles/global.css";
import TourCardRich from "../components/TourCardRich.astro";

const cidade = {
  eyebrow: "Rio de Janeiro",
  title: "Cristo, Pão de Açúcar e centro histórico",
  description: "Os ícones do Rio num dia, no seu ritmo, com guia carioca.",
  inclusions: ["Transporte privativo porta a porta", "Sem fila no Pão de Açúcar"],
  priceFrom: "445",
  priceBasis: "group",
  currency: "USD",
};
const ilha = {
  eyebrow: "Ilha Grande",
  title: "Escapada de lancha pela Costa Verde",
  description: "Praias, trilhas e mar aberto num bate-volta privativo saindo do Rio.",
  inclusions: ["Lancha privativa", "Guia certificado", "Água mineral a bordo", "Almoço na ilha"],
  priceFrom: "390",
  priceBasis: "boat",
  currency: "USD",
};
const serra = {
  eyebrow: "Petrópolis",
  title: "Cidade imperial nas montanhas",
  description: "História, clima de serra e arquitetura imperial a uma hora do Rio.",
  inclusions: ["Transporte privativo", "Guia certificado", "Ingressos inclusos"],
  priceFrom: "120",
  priceBasis: "person",
  currency: "USD",
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>B1c harness — TourCardRich</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/plus-jakarta-sans.css" />
    <style>
      .harness { background: var(--color-base); padding-block: var(--space-2xl); }
      .harness + .harness { border-block-start: var(--border-width-hairline) solid var(--color-hairline); }
      /* grid estreito: 3 células iguais */
      .grid-narrow { display: grid; gap: var(--space-m); grid-template-columns: repeat(3, 1fr); }
      /* grid assimétrico: célula larga + estreita (exercita o flex do card) */
      .grid-wide { display: grid; gap: var(--space-m); grid-template-columns: 1.7fr 1fr; margin-block-start: var(--space-l); }
      @media (max-width: 56rem) {
        .grid-narrow { grid-template-columns: 1fr; }
        .grid-wide { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <section class="harness">
      <div class="container">
        <div class="grid-narrow">
          <TourCardRich {...cidade} />
          <TourCardRich {...ilha} />
          <TourCardRich {...serra} />
        </div>

        <div class="grid-wide">
          <TourCardRich {...ilha} />
          <TourCardRich {...cidade} />
        </div>
      </div>
    </section>
  </body>
</html>
