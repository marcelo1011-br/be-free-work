---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DayTripsPillar from "../../components/DayTripsPillar.astro";
import { dayTripsProse } from "../../data/dayTripsContent.js";
import { getDayTripsSchema } from "../../utils/dayTripsSchema.js";

const lang = "en";
const t = dayTripsProse[lang];

const siteUrl = (Astro.site?.toString() || "https://befreetours.com.br").replace(/\/$/, "");
const schema = getDayTripsSchema(lang, siteUrl);

const breadcrumbItems = [
  { name: "Home", url: `/${lang}` },
  { name: t.hero.title, url: `/${lang}/day-trips-from-rio` },
];
---

<BaseLayout title={t.seo.title} description={t.seo.description} schema={schema}>
  <Breadcrumbs items={breadcrumbItems} />
  <DayTripsPillar lang={lang} />
</BaseLayout>
