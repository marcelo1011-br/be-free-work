---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experiences } from "../../data/experiences.js";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductListing from "../../components/ProductListing.astro";
import { getPageSEO, getProductsCollectionSchema, getBreadcrumbSchema } from "../../utils/seoHelpers.js";

const lang = "en";
const items = experiences[lang];
const siteUrl = (Astro.site?.toString() || "https://befreetours.com.br").replace(/\/$/, "");
const seo = getPageSEO("experiences", lang);
const collectionSchema = getProductsCollectionSchema(items, lang, siteUrl, "experiences");
const contactRoute = "contact";
const altRoute = "private-tours";
const breadcrumbItems = [
  { name: "Home", url: `/${lang}` },
  { name: "Experiences", url: `/${lang}/experiences` },
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems, siteUrl);
const schemas = [collectionSchema, breadcrumbSchema];
---

<BaseLayout title={seo.title} description={seo.description} schema={schemas}>
  <Breadcrumbs items={breadcrumbItems} />

  <ProductListing
    lang={lang}
    items={items}
    section="experiences"
    i18nPrefix="experiencesHub"
    filters={[
      { value: "all", labelKey: "filterAll" },
      { value: "walking-tours", labelKey: "filterWalking" },
    ]}
    contactRoute={contactRoute}
    altRoute={altRoute}
  />
</BaseLayout>
